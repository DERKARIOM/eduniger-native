<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- =====================================================================
         IDENTITÉ VISUELLE ELIM — source unique de la couleur de marque.
         Bleu de référence mesuré sur la maquette : #0D89CB.
         Pour changer l'identité de l'application, modifier UNIQUEMENT ce bloc
         (et son équivalent dans values-night/colors.xml).
         ===================================================================== -->
    <!-- Bleu principal : icônes actives, remplissages, sélection, progression -->
    <color name="brand_primary">#FF0D89CB</color>
    <!-- Bleu soutenu : textes/liens sur fond clair, états pressés (contraste 5,5:1 sur blanc) -->
    <color name="brand_primary_strong">#FF0A6FA6</color>
    <!-- Conteneur : fonds d'éléments sélectionnés, puces, pastilles -->
    <color name="brand_primary_container">#FFDCEFFA</color>
    <!-- Contenu posé sur le bleu / sur le conteneur -->
    <color name="brand_on_primary">#FFFFFFFF</color>
    <color name="brand_on_primary_container">#FF003A57</color>


    <!-- =====================================================================
         PALETTE CENTRALISÉE ELIM — rôles (mode clair ; mode sombre dans values-night).
         Toute nouvelle interface utilise CES noms. Contrastes vérifiés (WCAG) :
         texte principal 16:1, secondaire 5,6:1, indice 4,5:1, erreur/succès ≥ 4,8:1.
         ===================================================================== -->
    <color name="elim_primary">@color/brand_primary</color>
    <color name="elim_on_primary">@color/brand_on_primary</color>
    <color name="elim_primary_container">@color/brand_primary_container</color>
    <color name="elim_on_primary_container">@color/brand_on_primary_container</color>
    <!-- Bleu des textes et liens (lisible sur fond clair) -->
    <color name="elim_primary_text">@color/brand_primary_strong</color>
    <color name="elim_secondary">#FF3D5A6C</color>
    <color name="elim_background">#FFF6F8FA</color>
    <color name="elim_surface">#FFFFFFFF</color>
    <color name="elim_surface_variant">#FFEEF2F5</color>
    <color name="elim_on_surface">#FF141A1F</color>
    <color name="elim_on_surface_variant">#FF5A6570</color>
    <color name="elim_text_hint">#FF66707A</color>
    <color name="elim_outline">#FFD5DCE2</color>
    <color name="elim_error">#FFC62828</color>
    <color name="elim_on_error">#FFFFFFFF</color>
    <color name="elim_error_container">#FFFDECEA</color>
    <color name="elim_success">#FF2E7D32</color>
    <color name="elim_warning">#FFA15C00</color>
    <color name="elim_info">@color/brand_primary_strong</color>
    <color name="elim_disabled">#FF9AA4AD</color>

    <!-- Anciens noms conservés comme ALIAS (utilisés dans ~90 fichiers) :
         ils pointent tous vers la marque, ne plus y mettre de valeur en dur. -->
    <color name="purple_200">@color/brand_primary</color>
    <color name="purple2_200">@color/brand_primary</color>
    <color name="purple_500">@color/brand_primary_strong</color>
    <color name="purple_700">@color/brand_primary_strong</color>
    <color name="teal_200">@color/brand_primary</color>
    <color name="teal_700">@color/brand_primary_strong</color>
    <color name="black">#0D1318</color>
    <color name="white">#FFFFFFFF</color>
    <color name="whiteVert">#D1F6F9FC</color>
    <color name="white2">#EFEFEF</color>
    <color name="white3">#EBEBEB</color>
    <color name="whiteSombre">#B4EFEFEF</color>
    <color name="dark">#2B3940</color>
    <color name="black2">#E6252525</color>
    <color name="black3">#DF444444</color>
    <color name="sombre">#1f272a</color>
    <color name="hint">#3D444444</color>
    <color name="hint_sombre">#3DFBF8F8</color>
    <color name="rouge">#E6FD1010</color>
    <color name="vert">#005B4A</color>
    <color name="separator">@color/elim_outline</color>
    <color name="transparent">#00FFFFFF</color>
    <!-- Couleurs historiquement « sombres uniquement » (écran Livre, réservation,
         structure…) : texte blanc sur fond clair = INVISIBLE en mode clair.
         Elles suivent désormais la palette ; valeurs sombres d'origine dans values-night. -->
    <!-- Squelettes de chargement : gris clair en mode clair (était #2A2A2A partout) -->
    <color name="skeleton_base">#FFE3E8EC</color>
    <color name="bg_dark">@color/elim_background</color>
    <color name="bg_card">@color/elim_surface</color>
    <color name="bg_section">@color/elim_surface_variant</color>
    <color name="text_primary">@color/elim_on_surface</color>
    <color name="text_secondary">@color/elim_on_surface_variant</color>
    <!-- Indice / métadonnées : #555555 n'avait qu'un contraste de 2,2:1 en sombre -->
    <color name="text_hint">@color/elim_text_hint</color>
    <color name="accent_blue">@color/brand_primary</color>
    <color name="accent_blue_dark">@color/brand_primary_strong</color>
    <color name="divider">@color/elim_outline</color>

    <!-- ===== Lecteur audio (v2) : jetons de couleur adaptatifs clair/sombre ===== -->
    <!-- Valeurs "mode clair" ; les équivalents "mode sombre" sont dans values-night/colors.xml -->
    <color name="player_bg">@color/white</color>
    <color name="player_backdrop_top">#FFE3F2FA</color>
    <color name="player_surface">#14000000</color>
    <color name="player_surface_solid">#FFFFFFFF</color>
    <color name="player_text_primary">#FF14181B</color>
    <color name="player_text_secondary">#FF6B7278</color>
    <color name="player_control_inactive">#FFB3B8BC</color>
    <color name="player_track_bg">#FFE2E5E8</color>
    <color name="player_accent">@color/brand_primary</color>
    <!-- ===== Écran Compte (v2) : jetons "mode clair" (surcharges sombres dans values-night) ===== -->
    <color name="account_bg">#FFF4F7F5</color>
    <color name="account_card">#FFFFFFFF</color>
    <color name="account_card_alt">#FFEEF3F0</color>
    <color name="account_line">#FFE1E7E3</color>
    <color name="account_card_stroke">#FFE1E7E3</color>
    <color name="account_text">#FF141A17</color>
    <color name="account_text_muted">#FF5C6862</color>
    <color name="account_icon_muted">#FF8A948F</color>
    <color name="account_accent">@color/brand_primary_strong</color>
    <color name="account_accent_tint">#1F0D89CB</color>
    <color name="account_on_accent">#FFFFFFFF</color>
    <color name="account_danger">#FFC93C3C</color>
    <color name="account_danger_line">#59C93C3C</color>
    <!-- Fond de la pastille d'icône des boîtes de dialogue de confirmation « danger » -->
    <color name="account_danger_container">#1FC93C3C</color>
    <color name="account_cover">#FF17325A</color>
</resources>
