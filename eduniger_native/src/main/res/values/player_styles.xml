<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Style partagé pour les "chips" cliquables des feuilles vitesse / minuteur de sommeil -->
    <style name="PlayerChip">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_margin">4dp</item>
        <item name="android:paddingTop">10dp</item>
        <item name="android:paddingBottom">10dp</item>
        <item name="android:paddingStart">6dp</item>
        <item name="android:paddingEnd">6dp</item>
        <item name="android:gravity">center</item>
        <item name="android:background">@drawable/bg_player_chip</item>
        <item name="android:textColor">@color/player_text_primary</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:foreground">?attr/selectableItemBackground</item>
    </style>

    <style name="PlayerSpeedChip" parent="PlayerChip" />

    <style name="PlayerSleepChip" parent="PlayerChip">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_marginTop">6dp</item>
        <item name="android:layout_marginStart">0dp</item>
        <item name="android:layout_marginEnd">0dp</item>
        <item name="android:paddingTop">14dp</item>
        <item name="android:paddingBottom">14dp</item>
        <item name="android:gravity">start|center_vertical</item>
        <item name="android:paddingStart">18dp</item>
    </style>
</resources>
