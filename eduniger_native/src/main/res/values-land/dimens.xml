<?xml version="1.0" encoding="utf-8"?>
<!--
    LECTEUR AUDIO — surcharges PAYSAGE (téléphones).
    En paysage la hauteur disponible est très réduite (~360dp) : on compacte le
    rythme vertical et la typographie pour qu'aucun contrôle ne soit coupé.

    Note : le qualificateur "smallestWidth" est prioritaire sur "orientation",
    donc une tablette en paysage conserve bien les valeurs de values-sw600dp.
-->
