<?xml version="1.0" encoding="utf-8"?>
<!-- Champ de saisie : bordure discrète, bleu Elim quand le champ a le focus. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/account_card_alt" />
            <corners android:radius="14dp" />
            <stroke android:width="2dp" android:color="@color/brand_primary" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/account_card_alt" />
            <corners android:radius="14dp" />
            <stroke android:width="1dp" android:color="@color/account_line" />
        </shape>
    </item>
</selector>
