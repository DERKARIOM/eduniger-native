<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/elim_background">

    <!-- ══════════════════════ HEADER ══════════════════════ -->
    <LinearLayout
        android:id="@+id/header"
        android:layout_width="0dp"
        android:background="@color/elim_background"
        android:layout_height="56dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <!-- Bouton retour / menu -->
        <ImageButton
        android:scaleType="fitCenter"
        android:padding="5dp"
            android:id="@+id/btnBack"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/bg_bottom_nav"
            android:contentDescription="Menu"
            android:src="@drawable/vector_back"
            android:tint="@color/elim_on_surface" />

        <!-- Titre centré -->
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="Eduna IA"
            android:textColor="@color/elim_on_surface"
            android:textSize="17sp"
            android:textStyle="bold" />

        <!-- Bouton nouvelle conversation -->
        <ImageButton
        android:scaleType="fitCenter"
        android:padding="5dp"
            android:id="@+id/btnMenu"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/bg_bottom_nav"
            android:contentDescription="Nouvelle conversation"
            android:src="@drawable/ic_menu"
            android:tint="@color/elim_on_surface" />

    </LinearLayout>

    <!-- Séparateur -->
    <View
        android:id="@+id/divider"
        android:layout_width="0dp"
        android:layout_height="0.5dp"
        android:background="@color/elim_surface_variant"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/header" />

    <!-- ══════════ ÉCRAN VIDE (affiché quand aucun message) ══════════ -->
    <LinearLayout
        android:id="@+id/layoutEmptyState"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:orientation="vertical"
        android:gravity="center"
        android:paddingHorizontal="20dp"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/divider"
        app:layout_constraintBottom_toTopOf="@id/layoutInput"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Comment puis-je vous aider ?"
            android:textColor="@color/elim_on_surface"
            android:textSize="22sp"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginBottom="28dp" />

        <GridLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:columnCount="2"
            android:rowCount="2"
            android:useDefaultMargins="false">

            <!-- Suggestion 1 -->
            <LinearLayout
                android:id="@+id/action1"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:layout_margin="10dp"
                android:background="@drawable/bg_bottom_nav"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="12dp">
                <ImageView android:layout_width="15dp" android:layout_height="15dp"
                    android:src="@drawable/books_emp" android:layout_marginEnd="8dp"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Expliquer un livre" android:textColor="@color/elim_on_surface_variant" android:textSize="12sp"/>
            </LinearLayout>

            <!-- Suggestion 2 -->
            <LinearLayout
                android:id="@+id/action2"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:layout_margin="5dp"
                android:background="@drawable/bg_bottom_nav"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="12dp">
                <ImageView android:layout_width="15dp" android:layout_height="15dp"
                    android:src="@drawable/books_emp" android:layout_marginEnd="8dp"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Résumer un livre" android:textColor="@color/elim_on_surface_variant" android:textSize="12sp"/>
            </LinearLayout>

            <!-- Suggestion 3 -->
            <LinearLayout
                android:id="@+id/action3"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:layout_margin="10dp"
                android:background="@drawable/bg_bottom_nav"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="12dp">
                <ImageView android:layout_width="15dp" android:layout_height="15dp"
                    android:src="@drawable/books_emp" android:layout_marginEnd="8dp"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Poser une question" android:textColor="@color/elim_on_surface_variant" android:textSize="12sp"/>
            </LinearLayout>

            <!-- Suggestion 4 -->
            <LinearLayout
                android:id="@+id/action4"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:layout_margin="10dp"
                android:background="@drawable/bg_bottom_nav"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="12dp">
                <ImageView android:layout_width="15dp" android:layout_height="15dp"
                    android:src="@drawable/books_emp" android:layout_marginEnd="8dp"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Surprends-moi" android:textColor="@color/elim_on_surface_variant" android:textSize="12sp"/>
            </LinearLayout>

        </GridLayout>
    </LinearLayout>
    <!-- ══════════════════════ MESSAGES ══════════════════════ -->
    <androidx.recyclerview.widget.RecyclerView
        android:background="@color/elim_background"
        android:id="@+id/recyclerViewMessages"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:paddingBottom="8dp"
        android:paddingTop="8dp"
        android:scrollbars="none"
        app:layout_constraintBottom_toTopOf="@id/layoutTyping"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/divider" />

    <!-- ══════════════════════ INDICATEUR FRAPPE ══════════════ -->

    <LinearLayout
        android:id="@+id/layoutTyping"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginBottom="4dp"
        android:background="@drawable/bg_bubble_bot"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="14dp"
        android:paddingVertical="10dp"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@id/layoutInput"
        app:layout_constraintStart_toStartOf="parent">

        <!-- Trois points animés (typing) -->
        <View android:id="@+id/typing_dot_1" android:layout_width="7dp" android:layout_height="7dp"
            android:layout_marginEnd="3dp" android:layout_marginTop="2dp" android:background="@drawable/circle_typing_dot"/>
        <View android:id="@+id/typing_dot_2" android:layout_width="7dp" android:layout_height="7dp"
            android:layout_marginEnd="3dp" android:layout_marginTop="2dp" android:background="@drawable/circle_typing_dot"/>
        <View android:id="@+id/typing_dot_3" android:layout_marginTop="2dp" android:layout_width="7dp" android:layout_height="7dp"
            android:background="@drawable/circle_typing_dot"/>
    </LinearLayout>

    <!-- ══════════════════════ BARRE DE SAISIE ══════════════════ -->
    <LinearLayout
        android:id="@+id/layoutInput"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@color/elim_background"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp"
        android:paddingVertical="10dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <!-- Bouton pièce jointe (optionnel) -->
        <ImageButton
            android:id="@+id/btnAttach"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_bottom_nav"
            android:contentDescription="Joindre"
            android:src="@drawable/vector_white_sombre_add"
            android:tint="@color/elim_on_surface_variant" />

        <!-- Champ de texte -->
        <EditText
            android:id="@+id/etMessage"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="8dp"
            android:layout_weight="1"
            android:background="@drawable/bg_bottom_nav"
            android:hint="Message"
            android:maxLines="5"
            android:minHeight="44dp"
            android:paddingHorizontal="16dp"
            android:paddingVertical="10dp"
            android:textColor="@color/elim_on_surface"
            android:textSize="15sp" />

        <!-- Bouton envoyer -->
        <ImageButton
            android:id="@+id/btnSend"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_send_button"
            android:contentDescription="Envoyer"
            android:src="@drawable/vector_white_send"
            android:tint="@color/elim_surface" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>