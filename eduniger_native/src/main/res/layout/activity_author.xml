<?xml version="1.0" encoding="utf-8"?>
<!--
    Profil d'auteur (inspiré d'un profil professionnel) : une seule liste défilante
    (RecyclerView) = en-tête du profil + bibliographie paginée + pied (chargement / erreur / vide).
    La barre du haut reste fixe : transparente sur le bandeau, elle prend la couleur de surface
    et affiche le nom de l'auteur dès que l'en-tête est passé.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/elim_background"
    tools:context=".controleur.activity.AuthorActivity">

    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/swipe_refresh_author"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recycler_view_author_profile"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingBottom="32dp" />
    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

    <!-- Barre haute fixe -->
    <LinearLayout
        android:id="@+id/linear_layout_author_top_bar"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingEnd="8dp">

        <ImageButton
            android:id="@+id/image_button_author_back"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_profile_scrim_circle"
            android:contentDescription="@string/author_profile_back"
            android:padding="10dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_profile_back"
            android:tint="@color/elim_on_surface" />

        <TextView
            android:id="@+id/text_view_author_top_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp"
            android:layout_weight="1"
            android:alpha="0"
            android:ellipsize="end"
            android:importantForAccessibility="no"
            android:maxLines="1"
            android:textColor="@color/elim_on_surface"
            android:textSize="17sp"
            android:textStyle="bold"
            tools:alpha="1"
            tools:text="Bachir Abdoul Kader" />

        <ImageButton
            android:id="@+id/image_button_author_share_top"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_profile_scrim_circle"
            android:contentDescription="@string/author_profile_share"
            android:padding="11dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_profile_share"
            android:tint="@color/elim_on_surface" />
    </LinearLayout>

    <!-- Auteur introuvable (identifiant invalide ou auteur supprimé) -->
    <LinearLayout
        android:id="@+id/linear_layout_author_not_found"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/elim_background"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="32dp"
        android:visibility="gone">

        <FrameLayout
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:background="@drawable/bg_empty_state_icon">

            <ImageView
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_gravity="center"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_profile_person_off"
                android:tint="@color/elim_primary" />
        </FrameLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:gravity="center"
            android:text="@string/author_not_found_title"
            android:textColor="@color/elim_on_surface"
            android:textSize="19sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:lineSpacingExtra="3dp"
            android:text="@string/author_not_found_message"
            android:textColor="@color/elim_on_surface_variant"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/text_view_author_not_found_back"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:background="@drawable/bg_profile_primary_button"
            android:gravity="center"
            android:minHeight="44dp"
            android:paddingStart="28dp"
            android:paddingEnd="28dp"
            android:text="@string/author_profile_back"
            android:textColor="@color/elim_on_primary"
            android:textSize="15sp"
            android:textStyle="bold" />
    </LinearLayout>
</FrameLayout>
