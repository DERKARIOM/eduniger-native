<?xml version="1.0" encoding="utf-8"?>
<!-- Ligne de la section « Paramètres du compte » (écran Compte v2).
     Icône, titre et description sont renseignés par LibraryFragment.bindSettingRow(). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_account_row"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:minHeight="64dp"
    android:orientation="horizontal"
    android:paddingStart="16dp"
    android:paddingTop="12dp"
    android:paddingEnd="14dp"
    android:paddingBottom="12dp">

    <FrameLayout
        android:layout_width="38dp"
        android:layout_height="38dp"
        android:background="@drawable/bg_account_tile">

        <ImageView
            android:id="@+id/image_view_item_account_setting_icon"
            android:layout_width="19dp"
            android:layout_height="19dp"
            android:layout_gravity="center"
            android:importantForAccessibility="no"
            android:tint="@color/account_accent" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/text_view_item_account_setting_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/account_text"
            android:textSize="14.5sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/text_view_item_account_setting_description"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="@color/account_text_muted"
            android:textSize="12.5sp" />
    </LinearLayout>

    <ImageView
        android:layout_width="18dp"
        android:layout_height="18dp"
        android:layout_marginStart="8dp"
        android:importantForAccessibility="no"
        android:src="@drawable/ic_account_chevron"
        android:tint="@color/account_icon_muted" />
</LinearLayout>
