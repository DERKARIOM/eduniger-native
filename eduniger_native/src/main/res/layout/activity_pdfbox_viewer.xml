<?xml version="1.0" encoding="utf-8"?>
<!--
    Lecteur PDF Elim.
    - Pages : liste continue verticale, zoom par pincement / double-tap (ZoomRecyclerView).
    - Barre haute : retour, titre, recherche (Android 15+), aller à la page, menu.
    - Barre basse : « Page x / n » + curseur pour naviguer vite.
    - Tap sur la page : masque/affiche les barres (lecture plein écran).
    Couleurs : palette Elim (elim_*), adaptée aux modes clair et sombre.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/reader_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/reader_canvas"
    tools:context=".controleur.activity.PdfBoxViewerActivity">

    <com.naniger.elim.controleur.pdf.ZoomRecyclerView
        android:id="@+id/reader_pages"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:scrollbarStyle="outsideOverlay"
        android:scrollbars="vertical" />

    <!-- ===== Barre haute ===== -->
    <LinearLayout
        android:id="@+id/reader_top_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:background="@color/elim_surface"
        android:elevation="4dp"
        android:gravity="center_vertical"
        android:minHeight="56dp"
        android:orientation="horizontal"
        android:paddingStart="4dp"
        android:paddingEnd="4dp">

        <ImageButton
            android:id="@+id/reader_back"
            style="@style/ReaderIconButton"
            android:contentDescription="@string/a11y_back"
            android:src="@drawable/ic_reader_back" />

        <TextView
            android:id="@+id/reader_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/elim_on_surface"
            android:textSize="17sp"
            android:textStyle="bold"
            tools:text="Épreuve de Philosophie 2020" />

        <ImageButton
            android:id="@+id/reader_search"
            style="@style/ReaderIconButton"
            android:contentDescription="@string/reader_search"
            android:src="@drawable/ic_reader_search"
            android:visibility="gone" />

        <ImageButton
            android:id="@+id/reader_goto"
            style="@style/ReaderIconButton"
            android:contentDescription="@string/reader_goto_page"
            android:src="@drawable/ic_reader_goto" />

        <ImageButton
            android:id="@+id/reader_more"
            style="@style/ReaderIconButton"
            android:contentDescription="@string/reader_more"
            android:src="@drawable/ic_reader_more" />
    </LinearLayout>

    <!-- ===== Barre de recherche (remplace la barre haute) ===== -->
    <LinearLayout
        android:id="@+id/reader_search_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:background="@color/elim_surface"
        android:elevation="4dp"
        android:gravity="center_vertical"
        android:minHeight="56dp"
        android:orientation="horizontal"
        android:paddingStart="4dp"
        android:paddingEnd="4dp"
        android:visibility="gone">

        <ImageButton
            android:id="@+id/reader_search_close"
            style="@style/ReaderIconButton"
            android:contentDescription="@string/reader_search_close"
            android:src="@drawable/ic_reader_close" />

        <EditText
            android:id="@+id/reader_search_input"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:background="@drawable/bg_dialog_input"
            android:hint="@string/reader_search_hint"
            android:imeOptions="actionSearch"
            android:importantForAutofill="no"
            android:inputType="text"
            android:maxLines="1"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:textColor="@color/elim_on_surface"
            android:textColorHint="@color/elim_text_hint"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/reader_search_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:minWidth="44dp"
            android:gravity="center"
            android:textColor="@color/elim_on_surface_variant"
            android:textSize="13sp"
            tools:text="3 / 17" />

        <ImageButton
            android:id="@+id/reader_search_prev"
            style="@style/ReaderIconButton"
            android:contentDescription="@string/reader_search_prev"
            android:src="@drawable/ic_reader_up" />

        <ImageButton
            android:id="@+id/reader_search_next"
            style="@style/ReaderIconButton"
            android:contentDescription="@string/reader_search_next"
            android:src="@drawable/ic_reader_down" />
    </LinearLayout>

    <!-- ===== Barre basse : position + curseur ===== -->
    <LinearLayout
        android:id="@+id/reader_bottom_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@color/elim_surface"
        android:elevation="4dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingTop="8dp"
        android:paddingEnd="8dp"
        android:paddingBottom="8dp">

        <TextView
            android:id="@+id/reader_page_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="88dp"
            android:textColor="@color/elim_on_surface"
            android:textSize="14sp"
            android:textStyle="bold"
            tools:text="Page 12 / 240" />

        <SeekBar
            android:id="@+id/reader_seek"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:contentDescription="@string/reader_seek"
            android:progressTint="@color/elim_primary"
            android:thumbTint="@color/elim_primary" />
    </LinearLayout>

    <!-- Indicateur discret quand les barres sont masquées -->
    <TextView
        android:id="@+id/reader_page_chip"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="24dp"
        android:alpha="0"
        android:background="@drawable/bg_reader_chip"
        android:paddingStart="12dp"
        android:paddingTop="6dp"
        android:paddingEnd="12dp"
        android:paddingBottom="6dp"
        android:textColor="#FFFFFFFF"
        android:textSize="13sp"
        tools:alpha="1"
        tools:text="12 / 240" />

    <!-- ===== Chargement ===== -->
    <LinearLayout
        android:id="@+id/reader_loading"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/reader_canvas"
        android:gravity="center"
        android:orientation="vertical">

        <ProgressBar
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:indeterminateTint="@color/elim_primary" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/reader_opening"
            android:textColor="@color/elim_on_surface_variant"
            android:textSize="14sp" />
    </LinearLayout>

    <!-- ===== Erreur ===== -->
    <LinearLayout
        android:id="@+id/reader_error"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/elim_background"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="32dp"
        android:visibility="gone">

        <FrameLayout
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:background="@drawable/bg_dialog_icon_danger">

            <ImageView
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_gravity="center"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_reader_error"
                android:tint="@color/elim_error" />
        </FrameLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:gravity="center"
            android:text="@string/reader_error_title"
            android:textColor="@color/elim_on_surface"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/reader_error_message"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:lineSpacingExtra="2dp"
            android:textColor="@color/elim_on_surface_variant"
            android:textSize="14sp"
            tools:text="Le fichier est introuvable." />

        <TextView
            android:id="@+id/reader_error_close"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:layout_marginTop="24dp"
            android:background="@drawable/bg_dialog_button_secondary"
            android:gravity="center"
            android:paddingStart="28dp"
            android:paddingEnd="28dp"
            android:text="@string/reader_close"
            android:textColor="@color/elim_on_surface"
            android:textSize="15sp"
            android:textStyle="bold" />
    </LinearLayout>

</FrameLayout>
