<?xml version="1.0" encoding="utf-8"?>
<!--
    LECTEUR AUDIO — PORTRAIT

    Principe de mise en page (identique à Spotify / Deezer / YouTube Music) :
    la pile de contrôles est ANCRÉE AU BAS de l'écran, et la pochette absorbe
    tout l'espace vertical restant en conservant un ratio 1:1.

      toolbar ─────────── ancrée en haut
      pochette ────────── élastique (remplit le reste, plafonnée en largeur)
      titre + actions ─┐
      barre de progrès  │ ancrés au bas, dans cet ordre
      contrôles rangée 1│
      contrôles rangée 2┘ ancrée au parent

    Conséquences : sur un petit écran la pochette se réduit sans jamais couper
    les contrôles ; sur une tablette elle est plafonnée par player_cover_max_width
    au lieu de devenir géante.

    Toutes les tailles proviennent de res/values*/dimens.xml (surcharges
    sw600dp = tablette, land = paysage).

    Les icônes utilisent android:src (et NON android:background) : avec un
    background, l'image s'étire sur toute la cellule pondérée et app:tint est
    ignoré. La taille visuelle est pilotée par android:padding à l'intérieur
    d'une zone tactile de 48dp minimum (recommandation Material).
-->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/constraint_root_audio_player"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/player_bg"
    tools:context=".controleur.activity.AudioPlayerActivity">

    <!-- ===== FOND DÉGRADÉ (profondeur visuelle) ===== -->
    <View
        android:id="@+id/view_audio_player_backdrop"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@drawable/bg_player_backdrop_gradient"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toTopOf="@id/bloc_controls_row2" />

    <!-- ================================================================= -->
    <!-- TOOLBAR (ancrée en haut ; le padding haut reçoit l'inset système)  -->
    <!-- ================================================================= -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/toolbar_activity_audio_player"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:minHeight="56dp"
        android:paddingStart="4dp"
        android:paddingEnd="8dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:id="@+id/image_view_activity_audio_player_back"
            android:layout_width="@dimen/player_touch_target"
            android:layout_height="@dimen/player_touch_target"
            android:padding="@dimen/player_icon_pad_toolbar"
            android:scaleType="fitCenter"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/vector_white_back_player"
            app:tint="@color/player_text_primary"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            android:contentDescription="@string/player_back" />

        <!-- Bloc central : contraint ENTRE le bouton retour et les actions,
             donc jamais de chevauchement quel que soit le nombre d'icônes. -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:paddingStart="4dp"
            android:paddingEnd="4dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toEndOf="@id/image_view_activity_audio_player_back"
            app:layout_constraintEnd_toStartOf="@id/linear_layout_activity_audio_player_tool_bar">

            <TextView
                android:id="@+id/text_view_activity_audio_player_source_label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="@string/player_playing_from"
                android:textSize="@dimen/player_overline_text"
                android:textColor="@color/player_text_secondary"
                android:letterSpacing="0.1"
                android:textAllCaps="true"
                android:maxLines="1"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/text_view_activity_audio_player_source_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:gravity="center"
                android:text="@string/player_playing_from_library"
                android:textSize="@dimen/player_source_text"
                android:textStyle="bold"
                android:textColor="@color/player_text_primary"
                android:maxLines="1"
                android:ellipsize="end" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/linear_layout_activity_audio_player_tool_bar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <TextView
                android:id="@+id/text_view_activity_audio_player_speed"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="46dp"
                android:layout_gravity="center_vertical"
                android:layout_marginEnd="2dp"
                android:background="@drawable/bg_player_chip"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:paddingTop="6dp"
                android:paddingBottom="6dp"
                android:gravity="center"
                android:text="1.0x"
                android:textSize="@dimen/player_meta_text"
                android:textStyle="bold"
                android:maxLines="1"
                android:textColor="@color/player_text_primary"
                android:contentDescription="@string/player_speed" />

            <ImageView
                android:id="@+id/image_view_activity_audio_player_sleep_timer"
                android:layout_width="@dimen/player_touch_target_sm"
                android:layout_height="@dimen/player_touch_target_sm"
                android:padding="@dimen/player_icon_pad_toolbar"
                android:scaleType="fitCenter"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/vector_player_sleep_timer"
                app:tint="@color/player_text_primary"
                android:contentDescription="@string/player_sleep_timer" />

            <ImageView
                android:id="@+id/image_view_activity_audio_player_volume"
                android:layout_width="@dimen/player_touch_target_sm"
                android:layout_height="@dimen/player_touch_target_sm"
                android:padding="@dimen/player_icon_pad_toolbar"
                android:scaleType="fitCenter"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/vector_black2_volume"
                app:tint="@color/player_text_primary"
                android:contentDescription="@string/a11y_volume" />

            <ImageView
                android:id="@+id/image_view_activity_audio_player_tones"
                android:layout_width="@dimen/player_touch_target_sm"
                android:layout_height="@dimen/player_touch_target_sm"
                android:padding="@dimen/player_icon_pad_toolbar"
                android:scaleType="fitCenter"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/vector_black2_equalizer"
                app:tint="@color/player_text_primary"
                android:contentDescription="@string/a11y_equalizer" />
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- ================================================================= -->
    <!-- POCHETTE — élastique : remplit l'espace entre toolbar et titre,     -->
    <!-- ratio 1:1, largeur plafonnée (tablette), centrée.                   -->
    <!-- ================================================================= -->
    <ImageView
        android:id="@+id/image_view_activity_audio_player_cover"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="@dimen/player_cover_margin_h"
        android:layout_marginEnd="@dimen/player_cover_margin_h"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="@dimen/player_space_cover_to_title"
        android:elevation="@dimen/player_cover_elevation"
        android:scaleType="fitCenter"
        android:src="@drawable/vector_white_music"
        app:layout_constraintDimensionRatio="1:1"
        app:layout_constraintWidth_max="@dimen/player_cover_max_width"
        app:layout_constraintTop_toBottomOf="@id/toolbar_activity_audio_player"
        app:layout_constraintBottom_toTopOf="@id/relative_layout_activity_audio_player_list_love_add"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintVertical_bias="0.5"
        android:contentDescription="@string/a11y_play_pause" />

    <!-- ================================================================= -->
    <!-- TITRE + FAVORI + FILE D'ATTENTE (ancré au-dessus de la progression) -->
    <!-- ================================================================= -->
    <RelativeLayout
        android:id="@+id/relative_layout_activity_audio_player_list_love_add"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:paddingStart="@dimen/player_gutter"
        android:paddingEnd="@dimen/player_gutter_tight"
        android:layout_marginBottom="@dimen/player_space_title_to_seek"
        app:layout_constraintBottom_toTopOf="@id/bloc2"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintWidth_max="@dimen/player_cover_max_width">

        <LinearLayout
            android:id="@+id/linear_layout_activity_audio_player_actions"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/image_view_activity_audio_player_favorite"
                android:layout_width="@dimen/player_touch_target"
                android:layout_height="@dimen/player_touch_target"
                android:padding="@dimen/player_icon_pad_secondary"
                android:scaleType="fitCenter"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/vector_black3_off_like"
                android:contentDescription="@string/player_favorite" />

            <ImageView
                android:id="@+id/image_view_activity_audio_player_list"
                android:layout_width="@dimen/player_touch_target"
                android:layout_height="@dimen/player_touch_target"
                android:padding="@dimen/player_icon_pad_secondary"
                android:scaleType="fitCenter"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/vector_white_queue_music_24"
                app:tint="@color/player_text_primary"
                android:contentDescription="@string/player_queue" />
        </LinearLayout>

        <!-- layout_toStartOf garantit que le titre ne passe jamais SOUS les
             icônes d'action, même avec un titre très long. -->
        <LinearLayout
            android:id="@+id/linear_layout_activity_audio_player_titles"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_toStartOf="@id/linear_layout_activity_audio_player_actions"
            android:layout_centerVertical="true"
            android:paddingEnd="8dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/text_view_activity_audio_player_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="@dimen/player_title_text"
                android:textStyle="bold"
                android:maxLines="2"
                android:ellipsize="end"
                android:textColor="@color/player_text_primary"
                tools:text="Histoire des Haoussa" />

            <TextView
                android:id="@+id/text_view_activity_audio_player_author"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:textSize="@dimen/player_author_text"
                android:maxLines="1"
                android:ellipsize="end"
                android:textColor="@color/player_text_secondary"
                tools:text="Bachir Abdoul Kader" />

            <TextView
                android:id="@+id/text_view_activity_audio_player_sleep_remaining"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textSize="@dimen/player_meta_text"
                android:textStyle="bold"
                android:maxLines="1"
                android:ellipsize="end"
                android:textColor="@color/player_accent"
                android:visibility="gone"
                tools:text="Arrêt dans 12:34"
                tools:visibility="visible" />
        </LinearLayout>
    </RelativeLayout>

    <!-- ================================================================= -->
    <!-- BARRE DE PROGRESSION + TEMPS                                       -->
    <!-- ================================================================= -->
    <LinearLayout
        android:id="@+id/bloc2"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/player_gutter_tight"
        android:paddingEnd="@dimen/player_gutter_tight"
        android:layout_marginBottom="@dimen/player_space_seek_to_controls"
        app:layout_constraintBottom_toTopOf="@id/bloc_controls_row1"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintWidth_max="@dimen/player_cover_max_width">

        <SeekBar
            android:id="@+id/seek_bar_activity_audio_player"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:progressTint="@color/player_accent"
            android:thumbTint="@color/player_accent"
            android:progressBackgroundTint="@color/player_track_bg" />

        <!-- Temps écoulé / restant : chacun sur sa moitié, donc pas de collision
             même avec des durées > 1h (h:mm:ss). -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingStart="6dp"
            android:paddingEnd="6dp">

            <TextView
                android:id="@+id/text_view_activity_audio_player_duration_current"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="start"
                android:text="0:00"
                android:maxLines="1"
                android:textColor="@color/player_text_secondary"
                android:textSize="@dimen/player_meta_text" />

            <TextView
                android:id="@+id/text_view_activity_audio_player_duration_total"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="end"
                android:text="0:00"
                android:maxLines="1"
                android:textColor="@color/player_text_secondary"
                android:textSize="@dimen/player_meta_text" />
        </LinearLayout>
    </LinearLayout>

    <!-- ================================================================= -->
    <!-- RANGÉE 1 : shuffle / précédent / suivant / répéter                  -->
    <!-- Chaque cellule = zone tactile pondérée ; l'icône garde sa taille    -->
    <!-- grâce à src + scaleType + padding (et non background étiré).        -->
    <!-- ================================================================= -->
    <LinearLayout
        android:id="@+id/bloc_controls_row1"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="@dimen/player_gutter"
        android:paddingEnd="@dimen/player_gutter"
        android:layout_marginBottom="@dimen/player_space_row_gap"
        app:layout_constraintBottom_toTopOf="@id/bloc_controls_row2"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintWidth_max="@dimen/player_cover_max_width">

        <ImageView
            android:id="@+id/image_view_activity_audio_player_random"
            android:layout_width="0dp"
            android:layout_height="@dimen/player_touch_target"
            android:layout_weight="1"
            android:padding="@dimen/player_icon_pad_secondary"
            android:scaleType="fitCenter"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/vector_black2_shuffle_24"
            app:tint="@color/player_control_inactive"
            android:contentDescription="@string/player_shuffle" />

        <ImageView
            android:id="@+id/image_view_activity_audio_player_back_player"
            android:layout_width="0dp"
            android:layout_height="@dimen/player_touch_target"
            android:layout_weight="1"
            android:padding="@dimen/player_icon_pad_primary"
            android:scaleType="fitCenter"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/vector_black2_audio_player_back"
            app:tint="@color/player_text_primary"
            android:contentDescription="@string/player_previous" />

        <ImageView
            android:id="@+id/image_view_activity_audio_player_next_play"
            android:layout_width="0dp"
            android:layout_height="@dimen/player_touch_target"
            android:layout_weight="1"
            android:padding="@dimen/player_icon_pad_primary"
            android:scaleType="fitCenter"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/vector_black2_audio_player_next"
            app:tint="@color/player_text_primary"
            android:contentDescription="@string/player_next" />

        <FrameLayout
            android:id="@+id/frame_activity_audio_player_repeat"
            android:layout_width="0dp"
            android:layout_height="@dimen/player_touch_target"
            android:layout_weight="1">

            <ImageView
                android:id="@+id/image_view_activity_audio_player_auto_play"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:padding="@dimen/player_icon_pad_secondary"
                android:scaleType="fitCenter"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/vector_player_repeat"
                app:tint="@color/player_control_inactive"
                android:contentDescription="@string/player_repeat" />

            <TextView
                android:id="@+id/text_view_activity_audio_player_repeat_one_badge"
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:layout_gravity="center"
                android:layout_marginStart="20dp"
                android:layout_marginTop="20dp"
                android:background="@drawable/bg_circle_accent"
                android:gravity="center"
                android:text="1"
                android:textSize="9sp"
                android:textStyle="bold"
                android:textColor="@color/white"
                android:visibility="gone"
                tools:visibility="visible" />
        </FrameLayout>
    </LinearLayout>

    <!-- ================================================================= -->
    <!-- RANGÉE 2 : -10s / lecture-pause / +30s                             -->
    <!-- Ancrée au parent ; son padding bas reçoit l'inset de navigation.    -->
    <!-- ================================================================= -->
    <LinearLayout
        android:id="@+id/bloc_controls_row2"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:paddingStart="@dimen/player_gutter"
        android:paddingEnd="@dimen/player_gutter"
        android:paddingBottom="@dimen/player_bottom_padding"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintWidth_max="@dimen/player_cover_max_width">

        <FrameLayout
            android:id="@+id/frame_activity_audio_player_skip_back"
            android:layout_width="0dp"
            android:layout_height="@dimen/player_touch_target"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/player_skip_back_10">

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:padding="@dimen/player_icon_pad_secondary"
                android:scaleType="fitCenter"
                android:src="@drawable/vector_player_rotate_left"
                app:tint="@color/player_text_primary"
                android:importantForAccessibility="no" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginTop="1dp"
                android:text="10"
                android:textSize="9sp"
                android:textStyle="bold"
                android:textColor="@color/player_text_primary" />
        </FrameLayout>

        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1.4">

            <FrameLayout
                android:layout_width="@dimen/player_play_button_size"
                android:layout_height="@dimen/player_play_button_size"
                android:layout_gravity="center"
                android:background="@drawable/bg_circle_accent"
                android:elevation="6dp"
                android:foreground="?attr/selectableItemBackgroundBorderless">

                <ImageView
                    android:id="@+id/image_view_activity_audio_player_play"
                    android:layout_width="@dimen/player_play_icon_size"
                    android:layout_height="@dimen/player_play_icon_size"
                    android:layout_gravity="center"
                    android:scaleType="fitCenter"
                    android:src="@drawable/vector_black3_pause"
                    app:tint="@color/white"
                    android:contentDescription="@string/a11y_play_pause" />
            </FrameLayout>
        </FrameLayout>

        <FrameLayout
            android:id="@+id/frame_activity_audio_player_skip_forward"
            android:layout_width="0dp"
            android:layout_height="@dimen/player_touch_target"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/player_skip_forward_30">

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:padding="@dimen/player_icon_pad_secondary"
                android:scaleType="fitCenter"
                android:src="@drawable/vector_player_rotate_right"
                app:tint="@color/player_text_primary"
                android:importantForAccessibility="no" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginTop="1dp"
                android:text="30"
                android:textSize="9sp"
                android:textStyle="bold"
                android:textColor="@color/player_text_primary" />
        </FrameLayout>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
