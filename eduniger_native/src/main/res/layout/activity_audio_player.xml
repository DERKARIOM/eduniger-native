<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black"
    tools:context=".controleur.activity.AudioPlayerActivity">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- ===== TOOLBAR ===== -->
        <RelativeLayout
            android:id="@+id/toolbar_activity_audio_player"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_alignParentTop="true"
            android:paddingStart="8dp"
            android:paddingEnd="8dp">

            <ImageView
                android:id="@+id/image_view_activity_audio_player_back"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:padding="10dp"
                android:layout_centerVertical="true"
                android:layout_alignParentStart="true"
                android:background="@drawable/vector_white_back_player"
                android:contentDescription="@string/todo" />

            <LinearLayout
                android:id="@+id/linear_layout_activity_audio_player_tool_bar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:layout_alignParentEnd="true"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/image_view_activity_audio_player_replay"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_margin="10dp"
                    android:layout_gravity="center_vertical"
                    android:background="@drawable/vector_black2_replay"
                    />

                <ImageView
                    android:id="@+id/image_view_activity_audio_player_volume"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="center_vertical"
                    android:layout_margin="10dp"
                    android:background="@drawable/vector_black2_volume"
                    android:contentDescription="@string/todo" />

                <ImageView
                    android:id="@+id/image_view_activity_audio_player_tones"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_margin="10dp"
                    android:layout_gravity="center_vertical"
                    android:background="@drawable/vector_black2_equalizer"
                    android:contentDescription="@string/todo" />
            </LinearLayout>

            <!-- Centered source label -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"
                android:orientation="vertical"
                android:gravity="center">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="LECTURE DEPUIS"
                    android:textSize="10sp"
                    android:textColor="#AAAAAA"
                    android:letterSpacing="0.1"
                    android:textAllCaps="true" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Ma Bibliothèque"
                    android:layout_marginTop="5dp"
                    android:textSize="13sp"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold"
                    android:gravity="center" />
            </LinearLayout>
        </RelativeLayout>

        <!-- ===== COVER ===== -->
        <RelativeLayout
            android:id="@+id/relative_layout_activity_audio_player_book"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/toolbar_activity_audio_player"
            android:paddingStart="28dp"
            android:paddingEnd="28dp"
            android:paddingTop="40dp"
            android:paddingBottom="16dp">

            <ImageView
                android:id="@+id/image_view_activity_audio_player_cover"
                android:layout_width="match_parent"
                android:layout_height="350dp"
                android:src="@drawable/vector_white_music"
                android:scaleType="centerCrop"
                android:contentDescription="@string/todo" />
        </RelativeLayout>

        <!-- ===== TITLE + LOVE ===== -->
        <RelativeLayout
            android:id="@+id/relative_layout_activity_audio_player_list_love_add"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/relative_layout_activity_audio_player_book"
            android:paddingStart="28dp"
            android:paddingEnd="28dp"
            android:layout_marginTop="40dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/text_view_activity_audio_player_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF"
                    android:text="5 Astuces pour gagner sa vie" />

                <TextView
                    android:id="@+id/text_view_activity_audio_player_author"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:textSize="14sp"
                    android:textColor="#AAAAAA"
                    android:text="Artiste Inconnu" />
            </LinearLayout>

            <!-- Love button aligned to end -->
            <ImageView
                android:id="@+id/image_view_activity_audio_player_love"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:background="@drawable/vector_black2_favorite"
                android:contentDescription="@string/todo" />

            <!-- Add / list hidden but still accessible -->
            <ImageView
                android:id="@+id/image_view_activity_audio_player_add"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:visibility="gone"
                android:background="@drawable/vector_black2_add_24"
                android:contentDescription="@string/todo" />

            <ImageView
                android:id="@+id/image_view_activity_audio_player_list"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:visibility="gone"
                android:background="@drawable/vector_black2_queue_music_24"
                android:contentDescription="@string/todo" />
        </RelativeLayout>

        <!-- ===== SEEKBAR BLOC ===== -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:id="@+id/bloc2"
            android:layout_above="@id/bloc3"
            android:layout_height="50dp"
            android:layout_marginBottom="40dp"
            android:paddingStart="20dp"
            android:paddingEnd="20dp">

            <SeekBar
                android:id="@+id/seek_bar_activity_audio_player"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:progressTint="#FFFFFF"
                android:thumbTint="#FFFFFF"
                android:progressBackgroundTint="#3A3A3A"
                android:layout_marginTop="5dp" />

            <TextView
                android:id="@+id/text_view_activity_audio_player_duration_current"
                style="@style/wrap_content_all"
                android:text="0:00"
                android:layout_marginStart="4dp"
                android:layout_marginTop="10dp"
                android:textColor="#888888"
                android:textSize="12sp"
                android:layout_below="@id/seek_bar_activity_audio_player" />

            <TextView
                android:id="@+id/text_view_activity_audio_player_duration_total"
                style="@style/wrap_content_all"
                android:text="0:00"
                android:layout_alignParentEnd="true"
                android:layout_marginEnd="4dp"
                android:layout_marginTop="10dp"
                android:textColor="#888888"
                android:textSize="12sp"
                android:layout_below="@id/seek_bar_activity_audio_player" />
        </RelativeLayout>

        <!-- ===== CONTROLS BLOC ===== -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:id="@+id/bloc3"
            android:layout_marginStart="28dp"
            android:layout_marginEnd="28dp"
            android:layout_marginBottom="32dp"
            android:layout_alignParentBottom="true"
            android:layout_height="wrap_content">

            <!-- Shuffle -->
            <ImageView
                android:id="@+id/image_view_activity_audio_player_random"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:background="@drawable/vector_black2_shuffle_24"
                android:tint="#888888" />

            <!-- Previous -->
            <ImageView
                android:id="@+id/image_view_activity_audio_player_back_player"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_centerVertical="true"
                android:layout_marginStart="48dp"
                android:layout_toEndOf="@id/image_view_activity_audio_player_random"
                android:background="@drawable/vector_black2_audio_player_back"
                />

            <!-- Play/Pause — circular white button -->
            <FrameLayout
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:layout_centerInParent="true"
                android:background="@drawable/bg_circle_white">

                <ImageView
                    android:id="@+id/image_view_activity_audio_player_play"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:layout_gravity="center"
                    android:src="@drawable/vector_black3_pause"
                    android:contentDescription="@string/todo" />
            </FrameLayout>

            <!-- Next -->
            <ImageView
                android:id="@+id/image_view_activity_audio_player_next_play"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_centerVertical="true"
                android:layout_marginEnd="48dp"
                android:layout_toStartOf="@id/image_view_activity_audio_player_auto_play"
                android:background="@drawable/vector_black2_audio_player_next"
                />

            <!-- Auto-play / Repeat -->
            <ImageView
                android:layout_width="24dp"
                android:id="@+id/image_view_activity_audio_player_auto_play"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:background="@drawable/vector_black2_rotation_none"
                android:layout_height="24dp" />
        </RelativeLayout>

    </RelativeLayout>
</RelativeLayout>