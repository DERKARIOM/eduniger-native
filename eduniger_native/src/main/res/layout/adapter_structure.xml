<?xml version="1.0" encoding="utf-8"?>
<!-- Structure / « Ajouter un contenu » : logo rond de la même taille que les
     portraits d'auteurs (@dimen/author_avatar_size), nom, nombre de livres, bouton. -->
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:paddingStart="@dimen/section_gutter"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:paddingTop="10dp"
    android:paddingEnd="10dp"
    android:paddingBottom="10dp">
    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/image_view_adapter_structure_cover"
        android:layout_width="@dimen/author_avatar_size"
        android:layout_height="@dimen/author_avatar_size"
        android:layout_centerVertical="true"
        android:background="@color/skeleton_base"
        android:padding="0.5dp"
        android:scaleType="centerCrop"
        android:src="@drawable/img_wait_struct"
        android:importantForAccessibility="no"
        app:shapeAppearanceOverlay="@style/ShapeAppearance.Elim.Circle"
        app:strokeColor="@color/elim_outline"
        app:strokeWidth="1dp" />
    <RelativeLayout
        android:id="@+id/info_livre2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_toEndOf="@+id/image_view_adapter_structure_cover"
        android:layout_toStartOf="@+id/button_adapter_structure"
        android:layout_centerVertical="true">

        <TextView
            android:id="@+id/text_view_adapter_structure_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="NinoLib"
            android:textColor="@color/elim_on_surface"
            android:textSize="15sp"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/image_view_adapter_structure_book_number"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_marginTop="2dp"
            android:layout_below="@id/text_view_adapter_structure_title"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="293 Livres"
            android:textColor="@color/elim_on_surface_variant"
            android:textSize="13sp"/>
    </RelativeLayout>
    <Button
        android:id="@+id/button_adapter_structure"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minWidth="0dp"
        android:minHeight="38dp"
        android:gravity="center"
        android:includeFontPadding="false"
        android:paddingStart="20dp"
        android:paddingTop="9dp"
        android:paddingEnd="20dp"
        android:paddingBottom="9dp"
        app:insetTop="0dp"
        app:insetBottom="0dp"
        android:letterSpacing="0"
        android:textStyle="bold"
        android:text="S'adhérer"
        android:textAllCaps="false"
        style="@style/adapter_struture_btt"
        android:layout_margin="10dp"
        android:layout_alignParentEnd="true"
        android:layout_centerVertical="true"
        android:textSize="13sp"
        android:background="@drawable/bg_button_primary"
        android:backgroundTint="@color/purple_200"/>
</RelativeLayout>