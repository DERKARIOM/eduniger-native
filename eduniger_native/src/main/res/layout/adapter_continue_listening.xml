<?xml version="1.0" encoding="utf-8"?>
<!--
    Vignette « Reprendre l'écoute ».
    Pochette carrée + barre de progression réelle + titre/auteur, façon Spotify.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="@dimen/continue_item_width"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:layout_marginEnd="12dp"
    android:padding="4dp"
    android:background="?attr/selectableItemBackground"
    android:clickable="true"
    android:focusable="true">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/continue_item_width">

        <ImageView
            android:id="@+id/image_view_continue_cover"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:contentDescription="@string/todo" />

        <!-- Pastille de lecture en surimpression -->
        <FrameLayout
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:layout_gravity="bottom|end"
            android:layout_margin="6dp"
            android:background="@drawable/bg_circle_accent"
            android:elevation="4dp">

            <ImageView
                android:layout_width="15dp"
                android:layout_height="15dp"
                android:layout_gravity="center"
                android:scaleType="fitCenter"
                android:src="@drawable/vector_black3_play"
                android:contentDescription="@string/todo" />
        </FrameLayout>
    </FrameLayout>

    <ProgressBar
        android:id="@+id/progress_bar_continue"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="3dp"
        android:max="1000"
        android:progress="0"
        android:progressTint="@color/player_accent"
        android:progressBackgroundTint="@color/player_track_bg" />

    <TextView
        android:id="@+id/text_view_continue_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:textSize="13sp"
        android:textStyle="bold"
        android:maxLines="2"
        android:ellipsize="end"
        android:textColor="@color/player_text_primary"
        tools:text="Histoire des Haoussa" />

    <TextView
        android:id="@+id/text_view_continue_remaining"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:textSize="11sp"
        android:maxLines="1"
        android:ellipsize="end"
        android:textColor="@color/player_text_secondary"
        tools:text="Il reste 12 min" />

</LinearLayout>
