<?xml version="1.0" encoding="utf-8"?>
<!--
    Onglet Structures : une seule liste défilante = en-tête (titre, recherche, tri, filtres)
    + cartes des structures + état (chargement, erreur, vide, aucun résultat).
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/elim_background"
    tools:context=".controleur.fragment.StructureFragment">

    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/swipe_refresh_structure"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recycler_view_fragment_structure"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingBottom="@dimen/list_bottom_inset" />
    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
</FrameLayout>
