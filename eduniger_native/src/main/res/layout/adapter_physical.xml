<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="12dp"
    android:layout_marginEnd="12dp"
    android:layout_marginTop="6dp"
    android:layout_marginBottom="6dp"
    app:cardCornerRadius="16dp"
    app:cardElevation="6dp"
    app:cardBackgroundColor="@color/white">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="12dp">

        <!-- ══ Couverture du livre ══ -->
        <ImageView
            android:id="@+id/image_view_adapter_physical_blanket"
            android:layout_width="90dp"
            android:layout_height="120dp"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:scaleType="centerCrop"
            android:src="@drawable/img_wait_cover_book"
            app:cornerRadius="12dp"/>

        <!-- ══ Bloc informations ══ -->
        <LinearLayout
            android:id="@+id/info_livre_pysique"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_toEndOf="@id/image_view_adapter_physical_blanket"
            android:layout_centerVertical="true"
            android:orientation="vertical"
            android:paddingStart="12dp"
            android:paddingEnd="4dp">

            <!-- Titre -->
            <TextView
                android:id="@+id/text_view_adapter_physical_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Titre du livre"
                android:layout_marginBottom="5dp"
                android:textStyle="bold"
                android:textSize="15sp"
                android:textColor="@color/black"
                android:maxLines="2"
                android:ellipsize="end"
                android:lineSpacingExtra="2dp"/>

            <!-- Date d'emprunt -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="6dp">

                <ImageView
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:src="@drawable/calendar_check"
                    android:layout_marginBottom="5dp"
                    android:layout_marginEnd="4dp"/>

                <TextView
                    android:id="@+id/text_view_adapter_physical_date_init"
                    android:layout_width="wrap_content"
                    android:layout_marginBottom="5dp"
                    android:layout_height="wrap_content"
                    android:text="Emprunté le : 11/01/2025"
                    android:textSize="11sp"
                    android:textColor="@color/black3"/>

            </LinearLayout>

            <!-- Date retour prévue -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="3dp">

                <ImageView
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:src="@drawable/calendar_clock"
                    android:layout_marginEnd="4dp"/>

                <TextView
                    android:id="@+id/date_return"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Retour le : 11/03/2025"
                    android:textSize="11sp"
                    android:textColor="@color/vert"/>

            </LinearLayout>

            <!-- ══ ProgressBar temps restant ══ -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="10dp">

                <!-- Label + pourcentage -->
                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="4dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Temps restant"
                        android:textSize="10sp"
                        android:textColor="@color/black3"
                        android:layout_alignParentStart="true"/>

                    <TextView
                        android:id="@+id/text_view_adapter_physical_pourcentage"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="50%"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:textColor="@color/vert"
                        android:layout_alignParentEnd="true"/>

                </RelativeLayout>

                <!-- Barre de progression -->
                <ProgressBar
                    android:id="@+id/progress_bar_adapter_physical"
                    style="@android:style/Widget.ProgressBar.Horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="8dp"
                    android:progress="50"
                    android:progressBackgroundTint="@color/whiteSombre"
                    android:progressTint="@color/vert"/>

            </LinearLayout>

        </LinearLayout>

    </RelativeLayout>

</androidx.cardview.widget.CardView>