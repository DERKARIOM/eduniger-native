<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    tools:context=".controleur.activity.StructureActivity">

    <!-- TOOLBAR -->
    <RelativeLayout
        android:id="@+id/include2"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        style="@style/background">

        <ImageView
            android:id="@+id/image_view_toolbar_book"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_centerVertical="true"
            android:padding="8dp"
            android:src="@drawable/vector_back"
            android:tint="@color/text_primary"
            android:contentDescription="@string/todo" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageView
                android:id="@+id/image_view_toolbar_shortcut"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:padding="8dp"
                android:src="@drawable/shortcut"
                android:tint="@color/text_primary"
                android:contentDescription="@string/todo" />

            <ImageView
                android:id="@+id/image_view_toolbar_announcement"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:padding="8dp"
                android:src="@drawable/vector_black3_off_subscribe"
                android:tint="@color/text_primary"
                android:contentDescription="@string/todo" />

            <ImageView
                android:id="@+id/image_view_toolbar_research"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:padding="8dp"
                android:src="@drawable/ic_research"
                android:tint="@color/text_primary"
                android:contentDescription="@string/todo" />
        </LinearLayout>
    </RelativeLayout>

    <!-- SKELETON LOADING -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/skeleton_loading_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/include2"
        android:visibility="visible">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Banner -->
            <View
                android:layout_width="match_parent"
                android:layout_height="150dp"
                android:layout_marginStart="15dp"
                android:layout_marginEnd="15dp"
                android:layout_marginTop="0dp"
                android:background="@drawable/skeleton_shape" />

            <!-- Profile row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="20dp"
                android:gravity="center_vertical">

                <!-- Avatar -->
                <View
                    android:layout_width="70dp"
                    android:layout_height="70dp"
                    android:background="@drawable/skeleton_shape_circle"
                    android:layout_marginEnd="14dp" />

                <!-- Nom + auteur + adhérents -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <View
                        android:layout_width="140dp"
                        android:layout_height="18dp"
                        android:background="@drawable/skeleton_shape"
                        android:layout_marginBottom="8dp" />

                    <View
                        android:layout_width="100dp"
                        android:layout_height="12dp"
                        android:background="@drawable/skeleton_shape"
                        android:layout_marginBottom="8dp" />

                    <View
                        android:layout_width="200dp"
                        android:layout_height="12dp"
                        android:background="@drawable/skeleton_shape" />

                </LinearLayout>
            </LinearLayout>

            <!-- Description -->
            <View
                android:layout_width="260dp"
                android:layout_height="12dp"
                android:background="@drawable/skeleton_shape"
                android:layout_marginStart="20dp"
                android:layout_marginBottom="20dp" />

            <!-- Bouton adhérer -->
            <View
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginStart="20dp"
                android:layout_marginEnd="20dp"
                android:layout_marginBottom="20dp"
                android:background="@drawable/skeleton_shape" />

            <!-- Section Livres header -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingStart="25dp"
                android:paddingEnd="25dp"
                android:paddingTop="10dp"
                android:paddingBottom="10dp">
                <View
                    android:layout_width="80dp"
                    android:layout_height="14dp"
                    android:background="@drawable/skeleton_shape" />
                <View
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_weight="1" />
                <View
                    android:layout_width="60dp"
                    android:layout_height="14dp"
                    android:background="@drawable/skeleton_shape" />
            </LinearLayout>

            <!-- Livres horizontaux -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingStart="10dp"
                android:layout_marginBottom="20dp">
                <include layout="@layout/item_skeleton_book"/>
                <include layout="@layout/item_skeleton_book"/>
                <include layout="@layout/item_skeleton_book"/>
                <include layout="@layout/item_skeleton_book"/>
            </LinearLayout>

            <!-- Section Catégories header -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingStart="25dp"
                android:paddingEnd="25dp"
                android:paddingTop="10dp"
                android:paddingBottom="10dp">
                <View
                    android:layout_width="100dp"
                    android:layout_height="14dp"
                    android:background="@drawable/skeleton_shape" />
                <View
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_weight="1" />
                <View
                    android:layout_width="60dp"
                    android:layout_height="14dp"
                    android:background="@drawable/skeleton_shape" />
            </LinearLayout>

            <!-- Catégories -->
            <include layout="@layout/item_skeleton_category"/>
            <include layout="@layout/item_skeleton_category"/>
            <include layout="@layout/item_skeleton_category"/>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- CONTENU PRINCIPAL -->
    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/swipe_refresh_structure"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/include2">

        <androidx.core.widget.NestedScrollView
            android:id="@+id/nested_scroll_view_activity_structure"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <RelativeLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">

                <ImageView
                    android:id="@+id/image_view_structure_activity_welcome"
                    android:layout_width="match_parent"
                    android:layout_height="150dp"
                    android:layout_marginStart="15dp"
                    android:layout_marginEnd="15dp"
                    android:contentDescription="@string/todo"
                    android:elevation="6dp" />

                <RelativeLayout
                    android:layout_marginStart="20dp"
                    android:id="@+id/relative_layout_structure_activity_profile"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_below="@id/image_view_structure_activity_welcome">

                    <ImageView
                        android:id="@+id/image_view_structure_activity_profile"
                        android:layout_width="70dp"
                        android:layout_height="70dp"
                        android:layout_centerVertical="true"
                        android:src="@drawable/user" />

                    <LinearLayout
                        android:layout_margin="10dp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_toRightOf="@id/image_view_structure_activity_profile"
                        android:layout_centerVertical="true"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/text_view_structure_activity_name"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="OpenLab"
                            android:textStyle="bold"
                            android:textSize="20dp" />

                        <TextView
                            android:id="@+id/text_view_activity_structure_author"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="\@ninotech" />

                        <TextView
                            android:id="@+id/image_view_activity_structure_number"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="1,48 M d'Adhérents ° 293 Livres" />
                    </LinearLayout>
                </RelativeLayout>

                <RelativeLayout
                    android:id="@+id/linear_layout_activity_structure_button"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:layout_marginStart="20dp"
                    android:layout_below="@id/relative_layout_structure_activity_profile">

                    <TextView
                        android:id="@+id/text_view_activity_structure_description"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Bienvenue sur l'struture OpenLab !" />

                    <TextView
                        android:id="@+id/text_view_activity_structure_more_desc"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textStyle="bold"
                        android:paddingEnd="10dp"
                        android:layout_toRightOf="@+id/text_view_activity_structure_description"
                        android:text="...plus" />

                    <TextView
                        android:id="@+id/text_view_activity_structure_reduce_desc"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textStyle="bold"
                        android:paddingTop="10dp"
                        android:paddingEnd="10dp"
                        android:visibility="gone"
                        android:layout_below="@id/text_view_activity_structure_description"
                        android:text="Réduire" />
                </RelativeLayout>

                <RelativeLayout
                    android:id="@+id/relative_layout_activity_structure_btt"
                    style="@style/wrap_content_all"
                    android:layout_below="@+id/linear_layout_activity_structure_button"
                    android:layout_marginStart="20dp"
                    android:layout_marginEnd="20dp"
                    android:layout_marginTop="10dp"
                    android:layout_marginBottom="20dp">

                    <ProgressBar
                        android:id="@+id/progress_bar_register_connection"
                        style="@style/progress_bar_connection" />

                    <Button
                        android:id="@+id/button_activity_structure_adherer"
                        android:textAllCaps="false"
                        android:gravity="center"
                        android:paddingTop="-1dp"
                        style="@style/button_adhere" />
                </RelativeLayout>

                <RelativeLayout
                    android:id="@+id/relative_layout_activity_structure_more_book"
                    android:layout_below="@id/relative_layout_activity_structure_btt"
                    style="@style/match_wrap">

                    <TextView
                        style="@style/wrap_content_all"
                        android:layout_marginStart="25dp"
                        android:layout_marginTop="10dp"
                        android:layout_marginEnd="10dp"
                        android:layout_marginBottom="10dp"
                        android:text="Livres"
                        android:textStyle="bold"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/text_view_activity_structure_more_books"
                        style="@style/wrap_content_all"
                        android:layout_marginTop="10dp"
                        android:layout_marginEnd="25dp"
                        android:layout_marginBottom="10dp"
                        android:text="Voir plus"
                        android:layout_alignParentEnd="true"
                        android:textColor="@color/purple_200"
                        android:textStyle="bold"
                        android:textSize="14sp" />
                </RelativeLayout>

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/recycler_view_activity_structure_books"
                    android:nestedScrollingEnabled="false"
                    android:layout_margin="10dp"
                    android:layout_below="@id/relative_layout_activity_structure_more_book"
                    style="@style/match_parent_all" />

                <RelativeLayout
                    android:id="@+id/relative_layout_activity_structure_more_category"
                    android:layout_below="@id/recycler_view_activity_structure_books"
                    style="@style/match_wrap">

                    <TextView
                        style="@style/wrap_content_all"
                        android:layout_marginStart="25dp"
                        android:layout_marginTop="10dp"
                        android:layout_marginEnd="10dp"
                        android:layout_marginBottom="10dp"
                        android:text="Catégories"
                        android:textStyle="bold"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/text_view_activity_structure_more_category"
                        style="@style/wrap_content_all"
                        android:layout_marginTop="10dp"
                        android:layout_marginEnd="25dp"
                        android:layout_marginBottom="10dp"
                        android:text="Voir plus"
                        android:layout_alignParentEnd="true"
                        android:textColor="@color/purple_200"
                        android:textStyle="bold"
                        android:textSize="14sp" />
                </RelativeLayout>

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/recycler_view_activity_structure_category"
                    android:nestedScrollingEnabled="false"
                    android:layout_margin="10dp"
                    android:layout_below="@id/relative_layout_activity_structure_more_category"
                    style="@style/match_parent_all" />

                <RelativeLayout
                    android:id="@+id/relative_layout_activity_structure_author"
                    android:layout_below="@id/recycler_view_activity_structure_category"
                    android:visibility="gone"
                    style="@style/match_wrap">

                    <TextView
                        style="@style/wrap_content_all"
                        android:layout_marginStart="25dp"
                        android:layout_marginTop="10dp"
                        android:layout_marginEnd="10dp"
                        android:layout_marginBottom="10dp"
                        android:text="Les Auteurs"
                        android:textStyle="bold"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/text_view_activity_structure_more_author"
                        style="@style/wrap_content_all"
                        android:layout_marginTop="10dp"
                        android:layout_marginEnd="25dp"
                        android:layout_marginBottom="10dp"
                        android:text="Voir plus"
                        android:layout_alignParentEnd="true"
                        android:textColor="@color/purple_200"
                        android:textStyle="bold"
                        android:textSize="14sp" />
                </RelativeLayout>

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/recycler_view_activity_structure_author"
                    android:nestedScrollingEnabled="false"
                    android:layout_margin="10dp"
                    android:layout_below="@id/relative_layout_activity_structure_author"
                    style="@style/match_parent_all" />

            </RelativeLayout>
        </androidx.core.widget.NestedScrollView>

    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

    <!-- NO CONNECTION — EN DERNIER = au-dessus de tout -->
    <include
        android:id="@+id/no_connection_container"
        layout="@layout/item_no_connection"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/include2"
        android:visibility="gone" />

</RelativeLayout>