<?xml version="1.0" encoding="utf-8"?>
<!--
    Fiche d'une structure (page de présentation d'organisation) : une seule liste défilante
    = en-tête (identité, adhésion, À propos, chiffres, domaines, auteurs, outils de recherche)
    + ressources paginées + pied (chargement / erreur / vide / fin).
    Barre du haut fixe : transparente sur la bannière, puis surface + nom de la structure.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/elim_background"
    tools:context=".controleur.activity.StructureActivity">

    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/swipe_refresh_structure"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recycler_view_structure_profile"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingBottom="32dp" />
    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

    <!-- Barre haute fixe -->
    <LinearLayout
        android:id="@+id/linear_layout_structure_top_bar"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingEnd="8dp">

        <ImageButton
            android:id="@+id/image_button_structure_back"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_profile_scrim_circle"
            android:contentDescription="@string/author_profile_back"
            android:padding="10dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_profile_back"
            android:tint="@color/elim_on_surface" />

        <TextView
            android:id="@+id/text_view_structure_top_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:alpha="0"
            android:ellipsize="end"
            android:importantForAccessibility="no"
            android:maxLines="1"
            android:textColor="@color/elim_on_surface"
            android:textSize="17sp"
            android:textStyle="bold"
            tools:alpha="1"
            tools:text="Kit TD" />

        <ImageButton
            android:id="@+id/image_button_structure_announcements"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginEnd="6dp"
            android:background="@drawable/bg_profile_scrim_circle"
            android:contentDescription="@string/structure_announcements"
            android:padding="11dp"
            android:scaleType="fitCenter"
            android:src="@drawable/vector_black3_off_subscribe"
            android:tint="@color/elim_on_surface" />

        <ImageButton
            android:id="@+id/image_button_structure_share_top"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_profile_scrim_circle"
            android:contentDescription="@string/author_profile_share"
            android:padding="11dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_profile_share"
            android:tint="@color/elim_on_surface" />
    </LinearLayout>

    <!-- Structure introuvable (identifiant invalide ou structure supprimée) -->
    <LinearLayout
        android:id="@+id/linear_layout_structure_not_found"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/elim_background"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="32dp"
        android:visibility="gone">

        <FrameLayout
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:background="@drawable/bg_empty_state_icon">

            <ImageView
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_gravity="center"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_structure_building"
                android:tint="@color/elim_primary" />
        </FrameLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:gravity="center"
            android:text="@string/structure_not_found_title"
            android:textColor="@color/elim_on_surface"
            android:textSize="19sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:lineSpacingExtra="3dp"
            android:text="@string/structure_not_found_message"
            android:textColor="@color/elim_on_surface_variant"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/text_view_structure_not_found_back"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:background="@drawable/bg_profile_primary_button"
            android:gravity="center"
            android:minHeight="44dp"
            android:paddingStart="28dp"
            android:paddingEnd="28dp"
            android:text="@string/author_profile_back"
            android:textColor="@color/elim_on_primary"
            android:textSize="15sp"
            android:textStyle="bold" />
    </LinearLayout>
</FrameLayout>
