<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@color/player_surface_solid"
    android:paddingStart="24dp"
    android:paddingEnd="24dp"
    android:paddingTop="20dp"
    android:paddingBottom="28dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/player_speed_title"
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="@color/player_text_primary" />

    <LinearLayout
        android:id="@+id/linear_layout_dialog_speed_chips"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:orientation="horizontal"
        android:weightSum="5">

        <TextView android:id="@+id/chip_speed_0_5" style="@style/PlayerSpeedChip" android:text="0.5x" android:layout_weight="1" />
        <TextView android:id="@+id/chip_speed_0_75" style="@style/PlayerSpeedChip" android:text="0.75x" android:layout_weight="1" />
        <TextView android:id="@+id/chip_speed_1_0" style="@style/PlayerSpeedChip" android:text="1.0x" android:layout_weight="1" />
        <TextView android:id="@+id/chip_speed_1_25" style="@style/PlayerSpeedChip" android:text="1.25x" android:layout_weight="1" />
        <TextView android:id="@+id/chip_speed_1_5" style="@style/PlayerSpeedChip" android:text="1.5x" android:layout_weight="1" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="horizontal"
        android:weightSum="5">

        <TextView android:id="@+id/chip_speed_1_75" style="@style/PlayerSpeedChip" android:text="1.75x" android:layout_weight="1" />
        <TextView android:id="@+id/chip_speed_2_0" style="@style/PlayerSpeedChip" android:text="2.0x" android:layout_weight="1" />
        <TextView android:id="@+id/chip_speed_2_5" style="@style/PlayerSpeedChip" android:text="2.5x" android:layout_weight="1" />
        <TextView android:id="@+id/chip_speed_3_0" style="@style/PlayerSpeedChip" android:text="3.0x" android:layout_weight="1" />
        <View android:layout_width="0dp" android:layout_height="0dp" android:layout_weight="1" />
    </LinearLayout>

</LinearLayout>
