<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/relative_layout_toolbar_search"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_marginStart="25dp"
    android:layout_marginTop="20dp">
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar_search"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="?attr/actionBarSize"
        android:layout_centerVertical="true"
        app:titleMarginStart="15dp"
        android:paddingStart="20dp"
        app:titleTextColor="@color/black3"
        app:menu="@menu/menu_home"
        android:layout_alignParentTop="true"
        app:titleTextAppearance="@style/toolbar"
        tools:ignore="RtlSymmetry" />
    <EditText
        android:id="@+id/edit_text_toolbar_search"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        style="@style/activity_main_research"
        android:layout_alignParentEnd="true"
        android:layout_marginEnd="83dp"
        android:hint="  Rechercher un livre"
        android:drawableStart="?android:attr/actionModeWebSearchDrawable"
        android:inputType="text"
        android:layout_centerVertical="true"
        android:padding="8dp"
        android:focusable="false"
        android:selectAllOnFocus="false" />
    <!-- Icône Eduna. Mesures relevées sur capture (1080 px, densité ≈ 2,6) : le dessin de la
         cloche occupe environ 20 dp de haut et s'étend de 13 à 31 dp du bord droit.
         Le dessin « AI » remplit tout son cadre : 20 dp d'icône (48 - 2×14) = même taille
         visuelle que la cloche. Écart identique de 16 dp : recherche | AI | cloche
         (bord droit du dessin AI = 33 + 14 = 47 dp ; champ de recherche terminé à 83 dp). -->
    <ImageView
        android:id="@+id/image_view_toolbar_main_eduna"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_alignEnd="@id/toolbar_search"
        android:layout_centerVertical="true"
        android:layout_marginEnd="33dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/a11y_eduna"
        android:padding="14dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_ia" />
</RelativeLayout>