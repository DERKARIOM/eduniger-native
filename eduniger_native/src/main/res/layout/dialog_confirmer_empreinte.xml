<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_dialog_card"
    android:padding="20dp"
    android:orientation="vertical">
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Confirmer l'empreinte"
        android:textColor="@color/elim_on_surface"
        android:textSize="25sp"
        android:gravity="center"/>
    <ImageView
        android:id="@+id/EdigitaleConfirme"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:src="@drawable/vector_purple2_200_digitale"
        android:layout_marginTop="25dp"
        android:layout_marginBottom="25dp"
        />
    <TextView
        android:id="@+id/messageDigitaleConfirmer"
        android:textColor="@color/elim_on_surface"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Touchez le capteur d'empreinte"
        android:gravity="center"
        />


</LinearLayout>