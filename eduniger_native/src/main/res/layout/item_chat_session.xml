<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingHorizontal="20dp"
    android:paddingVertical="14dp">

    <!-- Icône conversation -->
    <ImageView
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:src="@drawable/ic_menu"
        android:tint="@color/elim_on_surface_variant"
        android:visibility="gone"
        android:contentDescription="Discussion" />

    <!-- Titre + date -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingHorizontal="12dp">

        <TextView
            android:id="@+id/tvSessionTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/elim_on_surface"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/tvSessionDate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="@color/elim_on_surface_variant"
            android:textSize="12sp" />

    </LinearLayout>

    <!-- Bouton suppression -->
    <ImageButton
        android:scaleType="fitCenter"
        android:padding="6dp"
        android:id="@+id/btnDeleteSession"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:background="@android:color/transparent"
        android:contentDescription="Supprimer"
        android:src="@drawable/ic_delete"
        android:tint="@color/elim_error" />

</LinearLayout>