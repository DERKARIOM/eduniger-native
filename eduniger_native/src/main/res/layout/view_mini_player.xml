<?xml version="1.0" encoding="utf-8"?>
<!--
    MINI LECTEUR FLOTTANT
    Toutes les dimensions viennent de res/values*/dimens.xml (variantes tablette
    et paysage incluses). Les icônes utilisent android:src + scaleType pour que
    app:tint s'applique et que l'image ne s'étire pas.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/card_mini_player"
    android:layout_width="match_parent"
    android:layout_height="@dimen/mini_player_height"
    android:orientation="vertical"
    android:background="@drawable/bg_mini_player"
    android:clickable="true"
    android:focusable="true"
    android:elevation="10dp"
    android:visibility="gone"
    tools:visibility="visible">

    <ProgressBar
        android:id="@+id/progress_bar_mini_player"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="2dp"
        android:max="1000"
        android:progress="0"
        android:progressTint="@color/player_accent"
        android:progressBackgroundTint="@color/player_track_bg" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="10dp"
        android:paddingEnd="4dp">

        <ImageView
            android:id="@+id/image_view_mini_player_cover"
            android:layout_width="@dimen/mini_player_cover"
            android:layout_height="@dimen/mini_player_cover"
            android:scaleType="centerCrop"
            android:src="@drawable/vector_white_music"
            android:contentDescription="@string/todo" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="10dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/text_view_mini_player_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/player_text_primary"
                android:textSize="13sp"
                android:textStyle="bold"
                android:maxLines="1"
                android:ellipsize="end"
                tools:text="Histoire des Haoussa" />

            <TextView
                android:id="@+id/text_view_mini_player_author"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:textColor="@color/player_text_secondary"
                android:textSize="11sp"
                android:maxLines="1"
                android:ellipsize="end"
                tools:text="Bachir Abdoul Kader" />
        </LinearLayout>

        <!-- Zones tactiles de 44dp minimum, icônes dimensionnées par le padding -->
        <ImageView
            android:id="@+id/image_view_mini_player_skip_back"
            android:layout_width="@dimen/player_touch_target_sm"
            android:layout_height="@dimen/player_touch_target_sm"
            android:padding="12dp"
            android:scaleType="fitCenter"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/vector_black2_audio_player_back"
            app:tint="@color/player_text_primary"
            android:contentDescription="@string/player_previous" />

        <ImageView
            android:id="@+id/image_view_mini_player_play"
            android:layout_width="@dimen/player_touch_target_sm"
            android:layout_height="@dimen/player_touch_target_sm"
            android:padding="10dp"
            android:scaleType="fitCenter"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/vector_black3_pause"
            app:tint="@color/player_text_primary"
            android:contentDescription="@string/todo" />

        <ImageView
            android:id="@+id/image_view_mini_player_next"
            android:layout_width="@dimen/player_touch_target_sm"
            android:layout_height="@dimen/player_touch_target_sm"
            android:padding="12dp"
            android:scaleType="fitCenter"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/vector_black2_audio_player_next"
            app:tint="@color/player_text_primary"
            android:contentDescription="@string/player_next" />
    </LinearLayout>

</LinearLayout>
