<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    style="@style/background"
    tools:context=".controleur.activity.BookActivity">

    <!-- TOOLBAR -->
    <RelativeLayout
        android:id="@+id/relative_layout_toolbar_book"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        style="@style/background">

        <ImageView
            android:id="@+id/image_view_toolbar_book"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_centerVertical="true"
            android:padding="8dp"
            android:src="@drawable/vector_back"
            android:tint="@color/text_primary"
            android:contentDescription="@string/todo" />
    </RelativeLayout>

    <!-- SKELETON LOADING -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/skeleton_loading_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/relative_layout_toolbar_book"
        android:layout_above="@id/bottom_action_bar"
        android:visibility="visible">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Couverture -->
            <View
                android:layout_width="180dp"
                android:layout_height="256dp"
                android:layout_gravity="center_horizontal"
                android:background="@drawable/skeleton_shape"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="24dp" />

            <!-- Badge catégorie -->
            <View
                android:layout_width="160dp"
                android:layout_height="12dp"
                android:layout_gravity="center_horizontal"
                android:background="@drawable/skeleton_shape"
                android:layout_marginBottom="12dp" />

            <!-- Titre -->
            <View
                android:layout_width="260dp"
                android:layout_height="20dp"
                android:layout_gravity="center_horizontal"
                android:background="@drawable/skeleton_shape"
                android:layout_marginBottom="8dp" />

            <View
                android:layout_width="200dp"
                android:layout_height="20dp"
                android:layout_gravity="center_horizontal"
                android:background="@drawable/skeleton_shape"
                android:layout_marginBottom="8dp" />

            <!-- Auteur -->
            <View
                android:layout_width="180dp"
                android:layout_height="12dp"
                android:layout_gravity="center_horizontal"
                android:background="@drawable/skeleton_shape"
                android:layout_marginBottom="6dp" />

            <!-- Cote -->
            <View
                android:layout_width="120dp"
                android:layout_height="10dp"
                android:layout_gravity="center_horizontal"
                android:background="@drawable/skeleton_shape"
                android:layout_marginBottom="24dp" />

            <!-- Métadonnées : 4 colonnes -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="24dp"
                android:gravity="center">

                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:orientation="vertical" android:gravity="center">
                    <View android:layout_width="24dp" android:layout_height="24dp"
                        android:background="@drawable/skeleton_shape_circle" android:layout_marginBottom="6dp"/>
                    <View android:layout_width="30dp" android:layout_height="10dp"
                        android:background="@drawable/skeleton_shape"/>
                </LinearLayout>

                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:orientation="vertical" android:gravity="center">
                    <View android:layout_width="24dp" android:layout_height="24dp"
                        android:background="@drawable/skeleton_shape_circle" android:layout_marginBottom="6dp"/>
                    <View android:layout_width="30dp" android:layout_height="10dp"
                        android:background="@drawable/skeleton_shape"/>
                </LinearLayout>

                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:orientation="vertical" android:gravity="center">
                    <View android:layout_width="24dp" android:layout_height="24dp"
                        android:background="@drawable/skeleton_shape_circle" android:layout_marginBottom="6dp"/>
                    <View android:layout_width="30dp" android:layout_height="10dp"
                        android:background="@drawable/skeleton_shape"/>
                </LinearLayout>

                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:orientation="vertical" android:gravity="center">
                    <View android:layout_width="24dp" android:layout_height="24dp"
                        android:background="@drawable/skeleton_shape_circle" android:layout_marginBottom="6dp"/>
                    <View android:layout_width="30dp" android:layout_height="10dp"
                        android:background="@drawable/skeleton_shape"/>
                </LinearLayout>

            </LinearLayout>

            <!-- Section card Format -->
            <View
                android:layout_width="match_parent"
                android:layout_height="90dp"
                android:background="@drawable/skeleton_shape"
                android:layout_marginBottom="16dp" />

            <!-- Section À propos -->
            <View
                android:layout_width="120dp"
                android:layout_height="16dp"
                android:background="@drawable/skeleton_shape"
                android:layout_marginBottom="12dp" />

            <View android:layout_width="match_parent" android:layout_height="12dp"
                android:background="@drawable/skeleton_shape" android:layout_marginBottom="8dp"/>
            <View android:layout_width="match_parent" android:layout_height="12dp"
                android:background="@drawable/skeleton_shape" android:layout_marginBottom="8dp"/>
            <View android:layout_width="240dp" android:layout_height="12dp"
                android:background="@drawable/skeleton_shape" android:layout_marginBottom="24dp"/>

            <!-- Section Commentaires -->
            <View
                android:layout_width="140dp"
                android:layout_height="16dp"
                android:background="@drawable/skeleton_shape"
                android:layout_marginBottom="12dp" />

            <include layout="@layout/item_skeleton_structure"/>
            <include layout="@layout/item_skeleton_structure"/>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- CONTENU PRINCIPAL -->
    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/swipe_refresh_book"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@id/bottom_action_bar"
        android:layout_below="@id/relative_layout_toolbar_book">

        <androidx.core.widget.NestedScrollView
            android:id="@+id/nested_scroll_view_activity_book"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone"
            android:clipToPadding="false"
            android:paddingBottom="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- Couverture centrée -->
                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingTop="8dp"
                    android:paddingBottom="24dp">

                    <ImageView
                        android:id="@+id/image_view_adapter_book_simple_cover"
                        android:layout_width="180dp"
                        android:layout_height="256dp"
                        android:layout_gravity="center_horizontal"
                        android:elevation="16dp"
                        android:src="@drawable/img_wait_cover_book"
                        android:scaleType="centerCrop"
                        android:contentDescription="@string/todo" />
                </FrameLayout>

                <!-- Badge catégorie -->
                <TextView
                    android:id="@+id/text_view_adapter_description_category"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginBottom="8dp"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:paddingTop="3dp"
                    android:paddingBottom="3dp"
                    android:text="@string/category_book"
                    android:textColor="@color/text_secondary"
                    android:textSize="11sp"
                    android:letterSpacing="0.12"
                    android:textAllCaps="true"
                    android:layout_marginStart="16dp" />

                <!-- Titre -->
                <TextView
                    android:id="@+id/text_view_adapter_book_simple_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="20dp"
                    android:layout_marginEnd="20dp"
                    android:layout_marginBottom="6dp"
                    android:gravity="center"
                    android:text="@string/book_title"
                    android:textColor="@color/text_primary"
                    android:textSize="24sp"
                    android:textStyle="bold"
                    android:lineSpacingExtra="2dp" />

                <!-- Auteur -->
                <TextView
                    android:id="@+id/text_view_adapter_book_simple_author_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginBottom="4dp"
                    android:text="De Bachir Abdoul Kader"
                    android:textColor="@color/text_secondary"
                    android:textSize="14sp" />

                <!-- Cote -->
                <TextView
                    android:id="@+id/text_view_adapter_book_simple_id_book"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginBottom="20dp"
                    android:text="Cote : MAT001"
                    android:textColor="@color/text_hint"
                    android:textSize="12sp" />

                <!-- Métadonnées -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_marginEnd="16dp"
                    android:layout_marginBottom="24dp"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:padding="12dp">

                    <LinearLayout
                        android:id="@+id/linear_layout_activity_book_like"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:orientation="vertical"
                        tools:ignore="UseCompoundDrawables">
                        <ImageView android:id="@+id/image_view_activity_book_like"
                            android:layout_width="22dp" android:layout_height="22dp"
                            android:src="@drawable/vector_black3_off_like"
                            android:tint="@color/text_secondary"
                            android:contentDescription="@string/todo" />
                        <TextView android:id="@+id/text_view_activity_book_number_like"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:layout_marginTop="3dp"
                            android:textColor="@color/text_secondary" android:textSize="12sp" />
                    </LinearLayout>

                    <View android:layout_width="1dp" android:layout_height="30dp"
                        android:background="@color/divider" />

                    <LinearLayout
                        android:id="@+id/linear_layout_activiry_book_nolike"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:orientation="vertical"
                        tools:ignore="UseCompoundDrawables">
                        <ImageView android:id="@+id/image_view_activity_book_no_like"
                            android:layout_width="22dp" android:layout_height="22dp"
                            android:src="@drawable/vector_black3_off_no_like"
                            android:tint="@color/text_secondary"
                            android:contentDescription="@string/todo" />
                        <TextView android:id="@+id/text_view_activity_book_number_no_like"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:layout_marginTop="3dp"
                            android:textColor="@color/text_secondary" android:textSize="12sp" />
                    </LinearLayout>

                    <View android:layout_width="1dp" android:layout_height="30dp"
                        android:background="@color/divider" />

                    <LinearLayout
                        android:id="@+id/linear_layout_activity_book_subscribe"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:orientation="vertical"
                        tools:ignore="UseCompoundDrawables">
                        <ImageView android:id="@+id/image_view_activity_book_subscribe"
                            android:layout_width="22dp" android:layout_height="22dp"
                            android:src="@drawable/vector_black3_off_subscribe"
                            android:tint="@color/text_secondary"
                            android:contentDescription="@string/todo" />
                        <TextView android:id="@+id/text_view_activity_book_number_subscribe"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:layout_marginTop="3dp"
                            android:textColor="@color/text_secondary" android:textSize="12sp" />
                    </LinearLayout>

                    <View android:layout_width="1dp" android:layout_height="30dp"
                        android:background="@color/divider" />

                    <LinearLayout
                        android:id="@+id/linear_layout_activity_book_nbr_view"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:orientation="vertical"
                        tools:ignore="UseCompoundDrawables">
                        <ImageView android:id="@+id/image_view_activity_book_view"
                            android:layout_width="22dp" android:layout_height="22dp"
                            android:src="@drawable/vector_black3_vue"
                            android:tint="@color/text_secondary"
                            android:contentDescription="@string/todo" />
                        <TextView android:id="@+id/text_view_activity_book_view"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:layout_marginTop="3dp" android:text="50"
                            android:textColor="@color/text_secondary" android:textSize="12sp" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Format Audio -->
                <LinearLayout
                    android:id="@+id/linear_layout_activity_book_audio"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_marginEnd="16dp"
                    android:layout_marginBottom="16dp"
                    android:background="@drawable/bg_section_card"
                    android:orientation="vertical"
                    android:padding="16dp"
                    android:visibility="gone">

                    <RelativeLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:layout_centerVertical="true" android:text="@string/audio_format"
                            android:textColor="@color/text_primary" android:textStyle="bold" android:textSize="14sp" />
                        <Spinner android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:layout_alignParentEnd="true" android:layout_centerVertical="true" />
                    </RelativeLayout>

                    <LinearLayout android:id="@+id/linear_layout_activity_book_media"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp" android:orientation="vertical">
                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:gravity="center_vertical" android:orientation="horizontal">
                            <RelativeLayout android:layout_width="wrap_content" android:layout_height="wrap_content">
                                <ProgressBar android:id="@+id/progress_bar_activity_book_wait_player"
                                    android:layout_width="36dp" android:layout_height="36dp"
                                    android:progressDrawable="@drawable/form_circular_bar_connexion" />
                                <ImageView android:id="@+id/image_view_activity_book_player"
                                    android:layout_width="36dp" android:layout_height="36dp"
                                    android:src="@drawable/vector_black3_pause"
                                    android:tint="@color/accent_blue" android:padding="4dp"
                                    android:contentDescription="@string/todo" />
                            </RelativeLayout>
                            <ImageView android:id="@+id/image_view_activity_book_stop"
                                android:layout_width="32dp" android:layout_height="32dp"
                                android:layout_marginStart="6dp" android:layout_marginEnd="6dp"
                                android:src="@drawable/vector_black3_stop"
                                android:tint="@color/text_secondary" android:padding="4dp"
                                android:contentDescription="@string/todo" />
                            <TextView android:id="@+id/text_view_activity_book_time_now"
                                android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:layout_marginEnd="8dp" android:text="@string/default_time"
                                android:textColor="@color/text_secondary" android:textSize="12sp"
                                android:fontFamily="monospace" />
                            <SeekBar android:id="@+id/seekbar_activity_book"
                                android:layout_width="0dp" android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:progressTint="@color/accent_blue" android:thumbTint="@color/accent_blue"
                                android:progress="100" />
                        </LinearLayout>
                    </LinearLayout>

                    <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:gravity="center_vertical" android:orientation="horizontal">
                        <FrameLayout
                            android:layout_width="wrap_content"
                            android:layout_height="40dp">

                            <Button android:id="@+id/button_activity_book_audio"
                                android:layout_width="wrap_content"
                                android:layout_height="40dp"
                                android:text="@string/audio_format"
                                android:textAllCaps="false"
                                android:textColor="@color/white"
                                android:textSize="13sp"
                                android:drawableStart="@drawable/vector_white_download"
                                android:drawablePadding="6dp"
                                android:backgroundTint="@color/accent_blue"
                                android:paddingStart="14dp"
                                android:paddingEnd="14dp"
                                android:stateListAnimator="@null" />

                            <LinearLayout
                                android:id="@+id/audio_download_progress_container"
                                android:layout_width="200dp"
                                android:layout_height="40dp"
                                android:orientation="horizontal"
                                android:gravity="center_vertical"
                                android:paddingStart="10dp"
                                android:paddingEnd="10dp"
                                android:visibility="gone">

                                <ProgressBar
                                    android:id="@+id/audio_download_progress_bar"
                                    style="@android:style/Widget.ProgressBar.Horizontal"
                                    android:layout_width="0dp"
                                    android:layout_height="6dp"
                                    android:layout_weight="1"
                                    android:max="100"
                                    android:progress="0"
                                    android:progressDrawable="@drawable/bg_audio_progress_bar" />

                                <TextView
                                    android:id="@+id/audio_download_percent_text"
                                    android:layout_width="36dp"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="8dp"
                                    android:text="0%"
                                    android:textSize="12sp"
                                    android:textStyle="bold"
                                    android:textColor="@color/accent_blue"
                                    android:gravity="end" />

                            </LinearLayout>

                        </FrameLayout>
                        <LinearLayout android:id="@+id/linear_layout_activity_book_audio_size"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:layout_marginStart="12dp" android:gravity="center_vertical"
                            android:orientation="horizontal" tools:ignore="UseCompoundDrawables">
                            <ImageView android:layout_width="16dp" android:layout_height="16dp"
                                android:src="@drawable/vector_black3_download" android:tint="@color/text_hint"
                                android:contentDescription="@string/todo" />
                            <TextView android:id="@+id/text_view_activity_book_audio_size"
                                android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:layout_marginStart="4dp" android:text="35Mo"
                                android:textColor="@color/text_hint" android:textSize="12sp" />
                        </LinearLayout>
                        <LinearLayout android:id="@+id/linear_layout_activity_book_maxTime"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:layout_marginStart="12dp" android:gravity="center_vertical"
                            android:orientation="horizontal" android:visibility="gone"
                            tools:ignore="UseCompoundDrawables">
                            <ImageView android:layout_width="16dp" android:layout_height="16dp"
                                android:src="@drawable/vector_black3_time" android:tint="@color/text_hint"
                                android:contentDescription="@string/todo" />
                            <TextView android:id="@+id/text_view_activity_book_audio_max_time"
                                android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:layout_marginStart="4dp" android:text="39:05"
                                android:textColor="@color/text_hint" android:textSize="12sp"
                                android:fontFamily="monospace" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>

                <!-- Format Électronique -->
                <LinearLayout
                    android:id="@+id/linear_layout_activity_book_electronic"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_marginEnd="16dp"
                    android:layout_marginBottom="16dp"
                    android:background="@drawable/bg_section_card"
                    android:orientation="vertical"
                    android:padding="16dp"
                    android:visibility="gone">

                    <RelativeLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:layout_centerVertical="true" android:text="@string/electronic_format"
                            android:textColor="@color/text_primary" android:textStyle="bold" android:textSize="14sp" />
                        <Spinner android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:layout_alignParentEnd="true" android:layout_centerVertical="true" />
                    </RelativeLayout>

                    <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:gravity="center_vertical" android:orientation="horizontal">
                        <FrameLayout
                            android:layout_width="wrap_content"
                            android:layout_height="40dp">

                            <Button android:id="@+id/button_activity_book_download_pdf"
                                android:layout_width="wrap_content"
                                android:layout_height="40dp"
                                android:background="@drawable/forme_purple2_200_radius_10dp"
                                android:text="@string/pdf_format"
                                android:textAllCaps="false"
                                android:textColor="@color/white"
                                android:textSize="13sp"
                                android:drawableStart="@drawable/vector_white_download"
                                android:drawablePadding="6dp"
                                android:backgroundTint="@color/purple_200"
                                android:paddingStart="14dp"
                                android:paddingEnd="14dp"
                                android:stateListAnimator="@null" />

                            <LinearLayout
                                android:id="@+id/pdf_download_progress_container"
                                android:layout_width="200dp"
                                android:layout_height="40dp"
                                android:orientation="horizontal"
                                android:gravity="center_vertical"
                                android:paddingStart="10dp"
                                android:paddingEnd="10dp"
                                android:visibility="gone">

                                <ProgressBar
                                    android:id="@+id/pdf_download_progress_bar"
                                    style="@android:style/Widget.ProgressBar.Horizontal"
                                    android:layout_width="0dp"
                                    android:layout_height="6dp"
                                    android:layout_weight="1"
                                    android:max="100"
                                    android:progress="0"
                                    android:progressDrawable="@drawable/bg_pdf_progress_bar" />

                                <TextView
                                    android:id="@+id/pdf_download_percent_text"
                                    android:layout_width="36dp"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="8dp"
                                    android:text="0%"
                                    android:textSize="12sp"
                                    android:textStyle="bold"
                                    android:textColor="@color/purple_200"
                                    android:gravity="end" />

                            </LinearLayout>

                        </FrameLayout>
                        <LinearLayout android:id="@+id/linear_layout_activity_book_pdf_size"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:layout_marginStart="12dp" android:gravity="center_vertical"
                            android:orientation="horizontal" android:visibility="gone"
                            tools:ignore="UseCompoundDrawables">
                            <ImageView android:layout_width="16dp" android:layout_height="16dp"
                                android:src="@drawable/vector_black3_off_like" android:tint="@color/text_hint"
                                android:contentDescription="@string/todo" />
                            <TextView android:id="@+id/text_view_activity_book_pdf_size"
                                android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:layout_marginStart="4dp" android:text="35Mo"
                                android:textColor="@color/text_hint" android:textSize="12sp" />
                        </LinearLayout>
                        <LinearLayout android:id="@+id/linear_layout_activity_book_nbr_page"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:layout_marginStart="12dp" android:gravity="center_vertical"
                            android:orientation="horizontal" android:visibility="gone"
                            tools:ignore="UseCompoundDrawables">
                            <ImageView android:layout_width="16dp" android:layout_height="16dp"
                                android:src="@drawable/vector_black3_vue" android:tint="@color/text_hint"
                                android:contentDescription="@string/todo" />
                            <TextView android:id="@+id/text_view_activity_book_pdf_max_page"
                                android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:layout_marginStart="4dp" android:text="300P"
                                android:textColor="@color/text_hint" android:textSize="12sp" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>

                <!-- Réservation physique -->
                <LinearLayout
                    android:id="@+id/linear_layout_activity_book_reservation"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_marginEnd="16dp"
                    android:layout_marginBottom="16dp"
                    android:background="@drawable/bg_section_card"
                    android:orientation="vertical"
                    android:padding="16dp"
                    android:visibility="gone">

                    <RelativeLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:layout_centerVertical="true" android:text="@string/to_book_reservation"
                            android:textColor="@color/text_primary" android:textStyle="bold" android:textSize="14sp" />
                        <Spinner android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:layout_alignParentEnd="true" android:layout_centerVertical="true" />
                    </RelativeLayout>

                    <Button android:id="@+id/button_activity_book_reservation"
                        android:layout_width="match_parent" android:layout_height="50dp"
                        android:text="@string/reservation_book" android:textAllCaps="false"
                        android:shadowRadius="50"
                        android:background="@drawable/forme_purple2_200_radius_10dp"
                        android:textColor="@color/white" android:textSize="14sp" android:textStyle="bold"
                        android:drawableStart="@drawable/vector_black3_physical2"
                        android:drawablePadding="8dp" android:backgroundTint="@color/purple_200"
                        android:stateListAnimator="@null" />
                </LinearLayout>

                <!-- À propos -->
                <LinearLayout
                    android:id="@+id/linear_layout_activity_book_about"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_marginEnd="16dp"
                    android:layout_marginBottom="16dp"
                    android:orientation="vertical">

                    <RelativeLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:layout_marginBottom="10dp">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:layout_centerVertical="true" android:text="@string/to_book_about"
                            android:textColor="@color/text_primary" android:textStyle="bold" android:textSize="16sp" />
                        <Spinner android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:layout_alignParentEnd="true" android:layout_centerVertical="true" />
                    </RelativeLayout>

                    <TextView android:id="@+id/text_view_activity_book_description"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:justificationMode="inter_word" android:lineSpacingExtra="4dp"
                        android:textColor="@color/text_secondary" android:textSize="14sp"
                        tools:targetApi="o" />
                </LinearLayout>

                <!-- Commentaires -->
                <LinearLayout
                    android:id="@+id/linear_layout_activity_book_comments"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_marginEnd="16dp"
                    android:layout_marginBottom="8dp"
                    android:orientation="vertical">

                    <RelativeLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:layout_marginBottom="10dp">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:layout_centerVertical="true" android:text="@string/comments"
                            android:textColor="@color/text_primary" android:textStyle="bold" android:textSize="16sp" />
                        <Spinner android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:layout_alignParentEnd="true" android:layout_centerVertical="true" />
                    </RelativeLayout>

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/recycler_view_activity_book_Comments"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />

                    <RelativeLayout
                        android:id="@+id/relative_layout_activity_book_comment"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:background="@drawable/bg_bottom_nav"
                        android:padding="4dp"
                        android:visibility="gone">

                        <EditText android:id="@+id/text_view_activity_book_message"
                            android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:background="@null" android:hint="@string/add_comments"
                            android:textColor="@color/text_primary" android:padding="10dp"
                            android:layout_marginEnd="44dp" android:importantForAutofill="no"
                            tools:ignore="TextFields" />

                        <ImageView android:id="@+id/image_view_activity_book_add_comments"
                            android:layout_width="36dp" android:layout_height="36dp"
                            android:layout_centerVertical="true" android:layout_alignParentEnd="true"
                            android:layout_marginEnd="4dp" android:padding="6dp"
                            android:src="@drawable/vector_white_send" android:tint="@color/purple_200"
                            android:background="@null" android:contentDescription="@string/todo" />
                    </RelativeLayout>
                </LinearLayout>

            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

    <!-- BARRE D'ACTIONS BAS -->
    <LinearLayout
        android:id="@+id/bottom_action_bar"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:layout_alignParentBottom="true"
        android:visibility="gone"
        android:background="@color/bg_dark"
        android:elevation="8dp"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp">

        <Button android:id="@+id/button_bottom_read"
            android:layout_width="0dp" android:layout_height="match_parent"
            android:layout_weight="1" android:layout_marginEnd="8dp"
            android:text="Lire" android:textAllCaps="false"
            android:textColor="@color/text_primary" android:textSize="15sp" android:textStyle="bold"
            android:drawableStart="@drawable/vector_black3_physical2" android:drawablePadding="6dp"
            android:backgroundTint="@color/bg_card" android:stateListAnimator="@null" />

        <Button android:id="@+id/button_bottom_listen"
            android:layout_width="0dp" android:layout_height="match_parent"
            android:layout_weight="2"
            android:text="Écouter" android:textAllCaps="false"
            android:textColor="@color/white" android:textSize="15sp" android:textStyle="bold"
            android:drawableStart="@drawable/vector_black3_off_subscribe" android:drawablePadding="6dp"
            android:backgroundTint="@color/accent_blue" android:stateListAnimator="@null"
            android:visibility="gone" />
    </LinearLayout>

    <!-- NO CONNECTION — EN DERNIER = au-dessus de tout -->
    <include
        android:id="@+id/no_connection_container"
        layout="@layout/item_no_connection"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/relative_layout_toolbar_book"
        android:layout_above="@id/bottom_action_bar"
        android:visibility="gone" />

</RelativeLayout>