<?xml version="1.0" encoding="utf-8"?>
<!--
   Configuration reseau de PRODUCTION : tout le trafic doit passer en HTTPS
   (elim.kawtal-consulting.com, api.kawtal-consulting.com).
   Seule exception : l'assistant IA, encore servi en HTTP par 78.46.46.154 (url_ai).
   A retirer des que l'IA sera servie en HTTPS.
   Les hotes de developpement (IP locales) sont autorises uniquement dans les builds
   debug : voir src/debug/res/xml/network_security_config.xml.
-->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">78.46.46.154</domain>
    </domain-config>
    <base-config cleartextTrafficPermitted="false" />
</network-security-config>
