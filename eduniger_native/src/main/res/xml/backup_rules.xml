<?xml version="1.0" encoding="utf-8"?>
<!--
   Regles de sauvegarde complete (Android < 12, ignore a partir d'API 31 qui utilise
   data_extraction_rules.xml).
   SECURITE : meme exclusion que data_extraction_rules.xml, voir ce fichier.
-->
<full-backup-content>
    <exclude domain="database" path="data.db" />
    <exclude domain="sharedpref" path="server_prefs.xml" />
        <!-- Jeton de connexion chiffre : sa cle reste dans le Keystore de l'appareil et ne
             peut pas etre restauree ailleurs (fichier illisible apres restauration). -->
        <exclude domain="sharedpref" path="eduniger_secure_auth_prefs.xml" />
</full-backup-content>
