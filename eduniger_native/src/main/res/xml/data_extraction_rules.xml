<?xml version="1.0" encoding="utf-8"?>
<!--
   Regles de sauvegarde/transfert (Android 12+).
   SECURITE : la base de donnees SQLite locale ("data.db") contient les identifiants de
   session, mots de passe (hashes) et jetons de l'utilisateur : elle est exclue de la
   sauvegarde cloud et du transfert d'appareil a appareil pour eviter toute fuite de ces
   donnees sensibles via une sauvegarde Google/adb.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="database" path="data.db" />
        <exclude domain="sharedpref" path="server_prefs.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="database" path="data.db" />
        <exclude domain="sharedpref" path="server_prefs.xml" />
    </device-transfer>
</data-extraction-rules>
