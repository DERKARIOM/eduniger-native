<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="AppTheme" parent="Theme.MaterialComponents.DayNight.DarkActionBar">
        <!-- Primary brand color. -->
        <item name="colorPrimary">@color/brand_primary</item>
        <item name="colorPrimaryVariant">@color/brand_primary_strong</item>
        <item name="colorOnPrimary">@color/brand_on_primary</item>
        <item name="colorAccent">@color/brand_primary</item>
        <item name="colorControlActivated">@color/brand_primary</item>
        <item name="materialButtonStyle">@style/Widget.Elim.Button</item>
        <item name="materialButtonOutlinedStyle">@style/Widget.Elim.Button.Outlined</item>
        <item name="borderlessButtonStyle">@style/Widget.Elim.Button.Text</item>
        <!-- Secondary brand color. -->
        <item name="colorSecondary">@color/brand_primary</item>
        <item name="colorSecondaryVariant">@color/brand_primary_strong</item>
        <item name="colorOnSecondary">@color/brand_on_primary</item>
        <!-- Rôles de la palette centralisée (values*/colors.xml : elim_*).
             NB : ce fichier (v23) est le thème réellement appliqué en mode CLAIR
             (minSdk 28) ; values/themes.xml n'est qu'un repli. -->
        <item name="android:textColorPrimary">@color/elim_on_surface</item>
        <item name="android:textColorSecondary">@color/elim_on_surface_variant</item>
        <item name="android:textColorHint">@color/elim_text_hint</item>
        <item name="colorSurface">@color/elim_surface</item>
        <item name="colorOnSurface">@color/elim_on_surface</item>
        <item name="colorError">@color/elim_error</item>
        <item name="colorOnError">@color/elim_on_error</item>
        <item name="android:colorBackground">@color/elim_background</item>
        <item name="colorOnBackground">@color/elim_on_surface</item>
        <item name="android:windowBackground">@color/elim_background</item>
        <!-- Barres système : icônes sombres sur fond clair -->
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:statusBarColor">@color/transparent</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="o_mr1">true</item>
        <item name="android:navigationBarColor">@color/elim_background</item>
        <!-- Customize your theme here. -->
    </style>
    <style name="botton_navigation">
        <item name="android:background">@color/white</item>
    </style>
    <style name="pdf_controle">
        <item name="android:background">@color/white</item>
    </style>
</resources>