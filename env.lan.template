APP_NAME=eduniger
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://192.168.49.1:8000

APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

############################################
# BASE DE DONNEES
# DB_DATABASE=eduniger (et non eduniger_test) pour rester la meme base
# que l'API mobile historique (voir /home/Admin/config_eduniger.php).
############################################
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=eduniger
DB_USERNAME=root
DB_PASSWORD=__A_REMPLACER__

############################################
# SESSION / AUTH
# eduniger-admin utilise des tokens Bearer (Sanctum "API tokens"), pas
# l'authentification par cookie stateful : ces reglages ont peu d'impact
# reel, mais SESSION_SECURE_COOKIE doit rester a false tant qu'on est en
# http:// simple (un cookie "Secure" n'est jamais envoye hors HTTPS).
############################################
SESSION_DRIVER=cookie
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_SECURE_COOKIE=false
SANCTUM_STATEFUL_DOMAINS=192.168.49.1:8090

############################################
# CACHE / QUEUE / BROADCAST
# Choix volontairement legers pour un telephone : pas de worker de queue
# a faire tourner en arriere-plan (sync = execution immediate), pas de
# table de cache a gerer (file = fichiers locaux), et le broadcasting
# temps reel (Reverb) est desactive pour ce premier deploiement de test
# (peut etre active plus tard si besoin des notifications en direct).
############################################
CACHE_STORE=file
QUEUE_CONNECTION=sync
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@eduniger.local"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

############################################
# API IA (optionnelle) - laisser vide desactive juste la generation IA,
# ne bloque plus le reste de l'application (voir AIBookService corrige).
############################################
GEMINI_API_KEY=

############################################
# API legacy (mobile), pour SendApiController - inchangee, meme serveur.
############################################
LEGACY_API_URL=http://127.0.0.1:2222/eduniger/api
