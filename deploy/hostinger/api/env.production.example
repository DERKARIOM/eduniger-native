# ===== API Laravel d'Elim — PRODUCTION (api.kawtal-consulting.com) =====
# Copier en ~/elim-api/.env puis remplir.
# Ne JAMAIS versionner le vrai fichier .env.

APP_NAME=Elim
APP_ENV=production
# Reprendre l'APP_KEY ACTUELLE du serveur existant (sinon données chiffrées illisibles).
# Seulement pour une toute première installation : php artisan key:generate
APP_KEY=
APP_DEBUG=false
APP_URL=https://api.kawtal-consulting.com
APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr

LOG_CHANNEL=daily
LOG_DAILY_DAYS=14
LOG_LEVEL=warning

# Base MySQL Hostinger (la même que l'API historique)
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=uXXXXXXXX_elim
DB_USERNAME=uXXXXXXXX_elim
DB_PASSWORD=

# Back-office (cookies Sanctum) et CORS
SANCTUM_STATEFUL_DOMAINS=admin.kawtal-consulting.com
SESSION_DOMAIN=.kawtal-consulting.com
SESSION_SECURE_COOKIE=true
SESSION_DRIVER=database
SESSION_LIFETIME=120
CORS_ALLOWED_ORIGINS=https://admin.kawtal-consulting.com

# Hébergement mutualisé : pas de Redis ni de processus permanent
CACHE_STORE=database
QUEUE_CONNECTION=database
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# API PHP historique (envoi des notifications push)
LEGACY_API_URL=https://elim.kawtal-consulting.com/eduniger/api

# Stockage des fichiers (inchangé : serveurs Hetzner)
HETZNER_SFTP_HOST=
HETZNER_SFTP_PORT=22
HETZNER_SFTP_USERNAME=
HETZNER_SFTP_PASSWORD=
HETZNER_SFTP_ROOT=
REMOTE_FILES_BASE_URL=
NEXTCLOUD_URI=http://78.46.46.154/remote.php/webdav/
NEXTCLOUD_USER=
NEXTCLOUD_PASS=

# IA
GEMINI_API_KEY=

# E-mails (boîte créée dans hPanel → E-mails)
MAIL_MAILER=log
MAIL_HOST=smtp.hostinger.com
MAIL_PORT=465
MAIL_SCHEME=smtps
MAIL_USERNAME=no-reply@kawtal-consulting.com
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=no-reply@kawtal-consulting.com
MAIL_FROM_NAME=Elim
