# ===== elim.kawtal-consulting.com — API PHP historique + ressources (/fabi/ressources) =====

# HTTPS obligatoire
RewriteEngine On
RewriteCond %{HTTPS} !=on
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# Pas de listage des dossiers
Options -Indexes

# Fichiers sensibles jamais servis
<FilesMatch "(^\.|\.(sql|bak|log|ini|env|md|sh|json\.bak)$|^composer\.(json|lock)$)">
    Require all denied
</FilesMatch>

# Scripts de développement / outils internes : interdits en production
<FilesMatch "^(hash_password\.php|callOpenAi\.php)$">
    Require all denied
</FilesMatch>

# Les fichiers inclus (connexion, authentification) ne s'appellent pas directement
RewriteRule ^eduniger/connectBDD\.php$ - [F,L]
RewriteRule ^eduniger/api/auth/ - [F,L]

# En-têtes de sécurité
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "DENY"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Strict-Transport-Security "max-age=31536000"
</IfModule>
