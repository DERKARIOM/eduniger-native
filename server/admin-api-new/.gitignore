# ==========================
# Laravel
# ==========================
/vendor/
/node_modules/
/public/hot
/public/storage
/storage/*.key
/storage/app/public
/storage/framework/cache/*
/storage/framework/sessions/*
/storage/framework/testing/*
/storage/framework/views/*
/storage/logs/*
/bootstrap/cache/*

# Ignorer tout sauf certains fichiers nécessaires
!/bootstrap/cache/.gitignore
!/storage/framework/cache/.gitignore
!/storage/framework/sessions/.gitignore
!/storage/framework/views/.gitignore

# ==========================
# Environment
# ==========================
.env
.env.*
!.env.example

# ==========================
# Composer
# ==========================
composer.phar

# ==========================
# NPM / Yarn
# ==========================
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ==========================
# IDE / Editors
# ==========================
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# ==========================
# OS Files
# ==========================
.DS_Store
Thumbs.db

# ==========================
# Logs
# ==========================
*.log

# ==========================
# Testing
# ==========================
/phpunit.result.cache

# ==========================
# Docker (optionnel)
# ==========================
docker-compose.override.yml

# ==========================
# Build tools
# ==========================
/public/build
/public/mix-manifest.json

# ==========================
# Misc
# ==========================
*.bak
*.tmp
*.temp